+#!/usr/bin/env python3
+"""MSDC image admission and shared-writer exclusion; no write commands."""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+from test_lab_msdc import MSDCLab
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--qemu", required=True, type=Path)
+    p.add_argument("--dtb", required=True, type=Path)
+    p.add_argument("--qemu-io", required=True, type=Path)
+    a = p.parse_args()
+    qemu, dtb, qio = a.qemu.resolve(), a.dtb.resolve(), a.qemu_io.resolve()
+    with tempfile.TemporaryDirectory(prefix="mt6762-msdc-inputs-") as td:
+        d = Path(td)
+        empty, short, fifo, image = (d / name for name in ("empty", "short", "fifo", "data.raw"))
+        empty.touch()
+        short.write_bytes(bytes(513))
+        os.mkfifo(fifo)
+        image.write_bytes(bytes(range(256)) * 4)
+        original = hashlib.sha256(image.read_bytes()).digest()
+        negative = [
+            ("mt6762,lab-msdc=on", "selected together"),
+            (f"mt6762,lab-msdc-image={image}", "selected together"),
+            (f"mt6762,lab-msdc=on,lab-msdc-image={d / 'absent'}", "regular file"),
+            (f"mt6762,lab-msdc=on,lab-msdc-image={d}", "regular file"),
+            (f"mt6762,lab-msdc=on,lab-msdc-image={fifo}", "regular file"),
+            (f"mt6762,lab-msdc=on,lab-msdc-image={empty}", "whole sectors"),
+            (f"mt6762,lab-msdc=on,lab-msdc-image={short}", "whole sectors"),
+        ]
+        for machine, reason in negative:
+            result = subprocess.run([str(qemu), "-M", machine, "-accel", "qtest",
+                                     "-m", "512M", "-smp", "1", "-dtb", str(dtb),
+                                     "-display", "none", "-serial", "null", "-monitor", "none"],
+                                    capture_output=True, text=True, timeout=10)
+            assert result.returncode != 0 and reason in result.stderr, result.stderr
+        labdir = d / "lab"
+        labdir.mkdir()
+        lab = MSDCLab(qemu, dtb, labdir, image)
+        try:
+            # qemu-io 'info' is observational; only its open requests RW permission.
+            writer = subprocess.run([str(qio), "-f", "raw", "-c", "info", str(image)],
+                                    capture_output=True, text=True, timeout=10)
+            assert writer.returncode != 0 and "lock" in writer.stderr.lower(), writer.stderr
+            reader = subprocess.run([str(qio), "-r", "-f", "raw", "-c", "info", str(image)],
+                                    capture_output=True, text=True, timeout=10)
+            assert reader.returncode == 0, reader.stderr
+            assert lab.state()["readonly"] and lab.state()["backend_reads"] == 0
+        finally:
+            lab.close()
+        reopened = subprocess.run([str(qio), "-f", "raw", "-c", "info", str(image)],
+                                  capture_output=True, text=True, timeout=10)
+        assert reopened.returncode == 0, reopened.stderr
+        assert hashlib.sha256(image.read_bytes()).digest() == original
+    print("PASS: paired options, regular whole-sector images, read-only sharing and writer-lock exclusion")
+
+
+if __name__ == "__main__":
+    main()
