diff --git a/hw/misc/mt6762_msdc_lab.c b/hw/misc/mt6762_msdc_lab.c
new file mode 100644
index 0000000..24cce24
--- /dev/null
+++ b/hw/misc/mt6762_msdc_lab.c
@@ -0,0 +1,283 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * AI-assisted local experiment; not intended for upstream submission.
+ *
+ * Opt-in inherited-state MSDC0 PIO fixture. Register offsets/command encodings
+ * follow supplied MT6765 headers and exact stock msdc_command_start/pio_read.
+ * The card is explicitly synthetic and already selected (RCA1, TRAN). Only
+ * CMD13, synthetic EXT_CSD CMD8 and CMD17 implement real read-only backing data.
+ * The 50us response and instantaneous FIFO refill are test assumptions.
+ * No card initialization, tuning, DMA, IRQ delivery, crypto or writes exist.
+ */
+#include "qemu/osdep.h"
+#include "hw/misc/mt6762_msdc_lab.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qobject/qdict.h"
+#include "system/block-backend.h"
+#include "system/reset.h"
+
+#define CMD_READY 0x100u
+#define CMD_TIMEOUT 0x200u
+#define CMD_CRC 0x400u
+#define DATA_DONE 0x1000u
+#define DATA_TIMEOUT 0x4000u
+#define DATA_CRC 0x8000u
+#define R1_TRAN_READY 0x900u
+
+struct MT6762MSDCLab {
+    MemoryRegion region;
+    BlockBackend *blk;
+    QEMUTimer *command_timer;
+    uint64_t sectors;
+    uint32_t arg, command, blocks, irq, response;
+    uint8_t data[512];
+    unsigned cursor, available, fault;
+    bool pending, reading;
+    uint64_t reads, writes, commands, cmd8, cmd13, cmd17, completed;
+    uint64_t bytes_read, backend_reads, backend_errors, rejected, ack_writes;
+};
+
+static void msdc_command_complete(void *opaque)
+{
+    MT6762MSDCLab *s = opaque;
+    s->pending = false;
+    if (s->fault == MT6762_MSDC_FAULT_COMMAND_TIMEOUT) {
+        s->irq |= CMD_TIMEOUT;
+        return;
+    }
+    if (s->fault == MT6762_MSDC_FAULT_COMMAND_CRC) {
+        s->irq |= CMD_CRC;
+        return;
+    }
+    s->response = R1_TRAN_READY;
+    s->irq |= CMD_READY;
+    if (s->fault == MT6762_MSDC_FAULT_WRONG_R1) {
+        s->response |= 1u << 22; /* R1 ILLEGAL_COMMAND. */
+        return;
+    }
+    if (s->command == 0x8d) {
+        return;
+    }
+    if (s->command == 0x02000888) {
+        /* These are fixture assumptions, not a recovered physical card. */
+        memset(s->data, 0, sizeof(s->data));
+        s->data[179] = s->fault == MT6762_MSDC_FAULT_EXTCSD_PARTITION ? 1 : 0;
+        s->data[15] = s->fault == MT6762_MSDC_FAULT_EXTCSD_QUEUE ? 1 : 0;
+        s->data[183] = s->fault == MT6762_MSDC_FAULT_EXTCSD_BUS ? 1 : 2;
+        s->data[185] = s->fault == MT6762_MSDC_FAULT_EXTCSD_TIMING ? 3 : 2;
+        s->data[192] = 8;
+        s->data[196] = 0x56; /* Synthetic HS52/DDR1.8/HS2001.8/HS4001.8. */
+        stl_le_p(s->data + 212,
+                 s->fault == MT6762_MSDC_FAULT_EXTCSD_CAPACITY ? 0 : s->sectors);
+    } else if (s->arg >= s->sectors) {
+        s->response |= 1u << 31; /* R1 OUT_OF_RANGE, no payload. */
+        return;
+    } else {
+        s->backend_reads++;
+        if (s->fault == MT6762_MSDC_FAULT_BACKEND_ERROR ||
+            blk_pread(s->blk, (uint64_t)s->arg * 512, 512, s->data, 0) < 0) {
+            s->backend_errors++;
+            s->irq |= DATA_TIMEOUT;
+            return;
+        }
+    }
+    s->reading = true;
+    s->cursor = 0;
+    s->available = s->fault == MT6762_MSDC_FAULT_SHORT_DATA ? 256 : 512;
+}
+
+static uint64_t msdc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MT6762MSDCLab *s = opaque;
+    uint32_t value;
+    s->reads++;
+    switch (offset) {
+    case 0x00: return 0x89; /* MODE, PIO, stable clock; synthetic inherited. */
+    case 0x0c:
+        return s->irq | (s->fault == MT6762_MSDC_FAULT_STALE_IRQ ? CMD_READY : 0);
+    case 0x10: return 0; /* Polling only, INTEN cannot be programmed. */
+    case 0x14: return MIN(s->available - s->cursor, 128u);
+    case 0x1c:
+        if (!s->reading || s->cursor + 4 > s->available) {
+            s->rejected++;
+            return 0;
+        }
+        value = ldl_le_p(s->data + s->cursor);
+        s->cursor += 4;
+        s->bytes_read += 4;
+        if (s->fault == MT6762_MSDC_FAULT_DATA_CRC && s->cursor == 128) {
+            s->available = s->cursor;
+            s->reading = false;
+            s->irq |= DATA_CRC;
+        } else if (s->cursor == 512) {
+            s->reading = false;
+            if (s->fault != MT6762_MSDC_FAULT_MISSING_DONE) {
+                s->irq |= DATA_DONE;
+                s->completed++;
+            }
+        }
+        return value;
+    case 0x30: return 0x20000; /* Synthetic inherited eight-bit bus. */
+    case 0x34: return s->command;
+    case 0x38: return s->arg;
+    case 0x3c:
+        return (s->pending ? 3 : s->reading ? 1 : 0) |
+               (s->fault == MT6762_MSDC_FAULT_BUSY ? 3 : 0);
+    case 0x40: return s->response;
+    case 0x50: return s->blocks;
+    case 0x9c: return 0; /* DMA inactive. */
+    case 0x204: return s->fault == MT6762_MSDC_FAULT_QUEUE ? 1 : 0;
+    case 0x23c: return s->fault == MT6762_MSDC_FAULT_QUEUE ? 3 : 0;
+    case 0x670: return s->fault == MT6762_MSDC_FAULT_CRYPTO ? 1 : 4;
+    default:
+        qemu_log_mask(LOG_UNIMP, "mt6762 lab MSDC: unsupported read %#" HWADDR_PRIx "\n", offset);
+        return 0;
+    }
+}
+
+static void msdc_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    MT6762MSDCLab *s = opaque;
+    uint32_t bits = value;
+    s->writes++;
+    if (offset == 0x0c) {
+        s->ack_writes++;
+        if (s->fault != MT6762_MSDC_FAULT_ACK_STUCK) {
+            s->irq &= ~bits; /* W1C subset only; unrelated flags survive. */
+        }
+        return;
+    }
+    if (s->pending || s->reading || s->fault == MT6762_MSDC_FAULT_BUSY ||
+        s->fault == MT6762_MSDC_FAULT_QUEUE ||
+        s->fault == MT6762_MSDC_FAULT_CRYPTO) {
+        s->rejected++;
+        return;
+    }
+    switch (offset) {
+    case 0x38: s->arg = bits; return;
+    case 0x50: s->blocks = bits; return;
+    case 0x34:
+        /* Never accept a new command over unacknowledged completion/error. */
+        if (s->irq || s->fault == MT6762_MSDC_FAULT_STALE_IRQ ||
+            !((bits == 0x8d && s->arg == 0x10000) ||
+              (bits == 0x02000891 && s->blocks == 1) ||
+              (bits == 0x02000888 && s->blocks == 1 && s->arg == 0))) {
+            s->rejected++;
+            return;
+        }
+        s->command = bits;
+        s->response = 0;
+        s->cursor = s->available = 0;
+        s->pending = true;
+        s->commands++;
+        if (bits == 0x8d) {
+            s->cmd13++;
+        } else if (bits == 0x02000888) {
+            s->cmd8++;
+        } else {
+            s->cmd17++;
+        }
+        timer_mod(s->command_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 50000);
+        return;
+    default:
+        /* No reset/FIFO-clear/configuration/DMA/crypto/data writes. */
+        s->rejected++;
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "mt6762 lab MSDC: rejected write %#" HWADDR_PRIx "=%#x\n",
+                      offset, bits);
+    }
+}
+
+static const MemoryRegionOps msdc_ops = {
+    .read = msdc_read, .write = msdc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void msdc_reset(void *opaque)
+{
+    MT6762MSDCLab *s = opaque;
+    timer_del(s->command_timer);
+    s->arg = s->command = s->blocks = s->irq = s->response = 0;
+    s->cursor = s->available = 0;
+    s->pending = s->reading = false;
+    memset(s->data, 0, sizeof(s->data));
+    s->reads = s->writes = s->commands = s->cmd8 = s->cmd13 = s->cmd17 = 0;
+    s->completed = s->bytes_read = s->backend_reads = s->backend_errors = 0;
+    s->rejected = s->ack_writes = 0;
+}
+
+void mt6762_msdc_lab_configure(MT6762MSDCLab *s, unsigned fault)
+{
+    assert(fault < MT6762_MSDC_FAULT_COUNT);
+    s->fault = fault;
+}
+
+char *mt6762_msdc_lab_state(MT6762MSDCLab *s)
+{
+    if (!s) {
+        return g_strdup("{\"enabled\":false}");
+    }
+    return g_strdup_printf("{\"enabled\":true,\"synthetic\":true,"
+        "\"readonly\":true,\"dma_emulated\":false,\"irq_delivery\":false,"
+        "\"fault\":%u,\"sectors\":%" PRIu64 ",\"commands\":%" PRIu64
+        ",\"cmd8\":%" PRIu64 ",\"cmd13\":%" PRIu64 ",\"cmd17\":%" PRIu64
+        ",\"completed\":%" PRIu64 ",\"bytes_read\":%" PRIu64
+        ",\"backend_reads\":%" PRIu64 ",\"backend_errors\":%" PRIu64
+        ",\"rejected\":%" PRIu64 ",\"ack_writes\":%" PRIu64
+        ",\"reads\":%" PRIu64 ",\"writes\":%" PRIu64
+        ",\"arg\":%u,\"command\":%u,\"irq\":%u,\"response\":%u,"
+        "\"fifo_bytes\":%u,\"pending\":%s,\"reading\":%s}",
+        s->fault, s->sectors, s->commands, s->cmd8, s->cmd13, s->cmd17, s->completed,
+        s->bytes_read, s->backend_reads, s->backend_errors, s->rejected,
+        s->ack_writes, s->reads, s->writes, s->arg, s->command, s->irq,
+        s->response, s->available - s->cursor,
+        s->pending ? "true" : "false", s->reading ? "true" : "false");
+}
+
+MT6762MSDCLab *mt6762_msdc_lab_create(Object *owner, MemoryRegion *memory,
+                                      const char *path, Error **errp)
+{
+    struct stat st;
+    BlockBackend *blk;
+    int64_t bytes;
+    QDict *options;
+    MT6762MSDCLab *s;
+    if (!path || stat(path, &st) || !S_ISREG(st.st_mode)) {
+        error_setg(errp, "lab-msdc-image must name an existing regular file");
+        return NULL;
+    }
+    /* Raw block length may round a partial final sector up. Reject the actual
+     * host-file remainder before opening, rather than exposing padded bytes. */
+    if (st.st_size < 512 || st.st_size % 512 ||
+        st.st_size / 512 > UINT32_MAX) {
+        error_setg(errp, "lab-msdc image must contain 1..UINT32_MAX whole sectors");
+        return NULL;
+    }
+    options = qdict_new();
+    qdict_put_str(options, "driver", "raw");
+    qdict_put_str(options, "file.driver", "file");
+    qdict_put_str(options, "file.filename", path);
+    blk = blk_new_open(NULL, NULL, options, BDRV_O_NO_SHARE, errp);
+    if (!blk) {
+        return NULL;
+    }
+    bytes = blk_getlength(blk);
+    if (bytes != st.st_size || blk_is_writable(blk)) {
+        error_setg(errp, "lab-msdc requires a read-only raw image of 1..UINT32_MAX whole sectors");
+        blk_unref(blk);
+        return NULL;
+    }
+    s = g_new0(MT6762MSDCLab, 1);
+    s->blk = blk;
+    s->sectors = bytes / 512;
+    s->command_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, msdc_command_complete, s);
+    memory_region_init_io(&s->region, owner, &msdc_ops, s, "mt6762.lab-msdc", 0x10000);
+    memory_region_add_subregion(memory, 0x11230000, &s->region);
+    msdc_reset(s);
+    qemu_register_reset(msdc_reset, s);
+    return s;
+}
diff --git a/include/hw/misc/mt6762_msdc_lab.h b/include/hw/misc/mt6762_msdc_lab.h
new file mode 100644
index 0000000..cecf462
--- /dev/null
+++ b/include/hw/misc/mt6762_msdc_lab.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_MISC_MT6762_MSDC_LAB_H
+#define HW_MISC_MT6762_MSDC_LAB_H
+#include "system/memory.h"
+#include "qapi/error.h"
+
+typedef struct MT6762MSDCLab MT6762MSDCLab;
+enum {
+    MT6762_MSDC_FAULT_NONE,
+    MT6762_MSDC_FAULT_BUSY,
+    MT6762_MSDC_FAULT_QUEUE,
