diff --git a/tests/mt6762/test_lab_msdc.py b/tests/mt6762/test_lab_msdc.py
new file mode 100644
index 0000000..9974eb0
--- /dev/null
+++ b/tests/mt6762/test_lab_msdc.py
@@ -0,0 +1,202 @@
+#!/usr/bin/env python3
+"""Read-only MSDC fixture tests; synthetic card, real temporary backing bytes.
+
+No physical device access. Tests require a locally built experimental QEMU.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+from test_lab_display import Lab
+
+BASE = 0x11230000
+
+
+class MSDCLab(Lab):
+    def __init__(self, qemu, dtb, directory, image, enabled=True):
+        directory = Path(directory)
+        self.log = (directory / "qemu.log").open("w+")
+        self.qmp_path = directory / "qmp.sock"
+        self.test_path = directory / "qtest.sock"
+        machine = "mt6762"
+        if enabled:
+            machine += f",lab-msdc=on,lab-msdc-image={image}"
+        self.process = subprocess.Popen([
+            str(qemu), "-M", machine, "-accel", "qtest", "-cpu", "cortex-a53",
+            "-m", "512M", "-smp", "1", "-dtb", str(dtb), "-display", "none",
+            "-serial", "null", "-monitor", "none",
+            "-qmp", f"unix:{self.qmp_path},server=on,wait=off",
+            "-qtest", f"unix:{self.test_path},server=on,wait=off",
+        ], stdout=self.log, stderr=self.log)
+        self.sockets = []
+        try:
+            self.qmp = self.connect(self.qmp_path)
+            self.test = self.connect(self.test_path)
+            assert "QMP" in json.loads(self.qmp.readline())
+            self.command("qmp_capabilities")
+        except BaseException:
+            self.close()
+            raise
+
+    def state(self):
+        return json.loads(self.command("qom-get", path="/machine", property="lab-msdc-state"))
+
+    def fault(self, name):
+        self.command("qom-set", path="/machine", property="lab-msdc-fault", value=name)
+
+    def r(self, reg):
+        return self.read(BASE + reg)
+
+    def w(self, reg, value):
+        self.write(BASE + reg, value)
+
+    def step(self):
+        self.access("clock_step 50000")
+
+    def issue(self, cmd, arg):
+        self.w(0x50, 1)
+        self.w(0x38, arg)
+        self.w(0x34, cmd)
+        assert self.r(0x3c) & 2
+        self.step()
+
+    def drain(self):
+        data = bytearray()
+        # Bounded independently from completion flags, as the real driver must be.
+        for _ in range(128):
+            count = self.r(0x14) & 255
+            if count == 0:
+                break
+            assert count <= 128 and count % 4 == 0
+            data += struct.pack("<I", self.r(0x1c))
+        return bytes(data)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--qemu", type=Path, required=True)
+    p.add_argument("--dtb", type=Path, required=True)
+    a = p.parse_args()
+    with tempfile.TemporaryDirectory(prefix="mt6762-msdc-qtest-") as td:
+        directory = Path(td)
+        image = directory / "backing.raw"
+        backing = bytes((i * 37 + i // 512) & 255 for i in range(4096))
+        image.write_bytes(backing)
+        digest = hashlib.sha256(backing).digest()
+
+        def instance(label, enabled=True):
+            path = directory / label
+            path.mkdir()
+            return MSDCLab(a.qemu.resolve(), a.dtb.resolve(), path, image, enabled)
+
+        lab = instance("positive")
+        try:
+            assert lab.r(0) == 0x89 and lab.r(0x30) == 0x20000
+            assert lab.r(0x10) == lab.r(0x3c) == lab.r(0x9c) == 0
+            assert lab.r(0x204) == lab.r(0x23c) == 0 and lab.r(0x670) == 4
+            lab.issue(0x8d, 0x10000)
+            assert lab.r(0xc) == 0x100 and lab.r(0x40) == 0x900
+            lab.w(0xc, 0x100)
+            assert lab.r(0xc) == 0
+            lab.issue(0x02000888, 0)
+            lab.w(0xc, 0x100)
+            ext = lab.drain()
+            assert len(ext) == 512 and ext[15] == 0 and ext[179] == 0
+            assert ext[183] == ext[185] == 2 and ext[192] == 8 and ext[196] == 0x56
+            assert int.from_bytes(ext[212:216], "little") == 8
+            assert lab.r(0xc) == 0x1000
+            lab.w(0xc, 0x100)  # W1C must preserve the unrelated data-done flag.
+            assert lab.r(0xc) == 0x1000
+            lab.w(0xc, 0x1000)
+            for lba in [0, 7, 3]:
+                lab.issue(0x02000891, lba)
+                assert lab.r(0xc) == 0x100 and lab.r(0x14) == 128
+                lab.w(0xc, 0x100)
+                assert lab.drain() == backing[lba * 512:(lba + 1) * 512]
+                assert lab.r(0xc) == 0x1000 and lab.r(0x3c) == 0
+                lab.w(0xc, 0x1000)
+            lab.issue(0x02000891, 8)
+            assert lab.r(0x40) & (1 << 31) and lab.r(0x14) == 0
+            lab.w(0xc, 0x100)
+            before = lab.state()
+            for reg, value in [(0, 4), (0x14, 1 << 31), (0x10, 0xffffffff),
+                               (0x670, 0), (0x98, 1), (0x18, 0x12345678)]:
+                lab.w(reg, value)
+            lab.w(0x34, 0x02002898)  # Write-single-block CMD24 must be rejected.
+            after = lab.state()
+            assert after["rejected"] == before["rejected"] + 7
+            assert after["backend_reads"] == 3 and after["readonly"]
+            assert after["completed"] == 4 and after["cmd8"] == 1
+        finally:
+            lab.close()
+
+        for fault in ["busy", "queue", "crypto", "stale-irq"]:
+            lab = instance(fault)
+            try:
+                lab.fault(fault)
+                if fault == "busy": assert lab.r(0x3c) == 3
+                if fault == "queue": assert lab.r(0x204) == 1 and lab.r(0x23c) == 3
+                if fault == "crypto": assert lab.r(0x670) == 1
+                if fault == "stale-irq": assert lab.r(0xc) == 0x100
+                assert lab.state()["commands"] == 0
+            finally:
+                lab.close()
+
+        for fault in ["command-crc", "command-timeout", "data-crc", "short-data",
+                      "missing-done", "ack-stuck", "backend-error", "wrong-r1"]:
+            lab = instance(fault)
+            try:
+                lab.fault(fault)
+                lab.issue(0x02000891, 1)
+                if fault in ("command-crc", "command-timeout"):
+                    assert lab.r(0xc) == (0x400 if fault == "command-crc" else 0x200)
+                    assert lab.r(0x14) == 0 and lab.state()["backend_reads"] == 0
+                    continue
+                if fault == "wrong-r1":
+                    assert lab.r(0x40) & (1 << 22) and lab.r(0x14) == 0
+                    continue
+                lab.w(0xc, 0x100)
+                if fault == "ack-stuck":
+                    assert lab.r(0xc) == 0x100
+                    continue
+                result = lab.drain()
+                if fault == "backend-error":
+                    assert not result and lab.r(0xc) == 0x4000
+                    assert lab.state()["backend_errors"] == 1
+                elif fault == "data-crc":
+                    assert len(result) == 128 and lab.r(0xc) == 0x8000
+                elif fault == "short-data":
+                    assert len(result) == 256 and lab.r(0xc) == 0
+                elif fault == "missing-done":
+                    assert result == backing[512:1024] and lab.r(0xc) == 0
+                assert lab.state()["completed"] == 0
+            finally:
+                lab.close()
+
+        for fault, index, expected in [("extcsd-partition", 179, 1), ("extcsd-queue", 15, 1),
+                                       ("extcsd-bus", 183, 1), ("extcsd-timing", 185, 3),
+                                       ("extcsd-capacity", 212, 0)]:
+            lab = instance(fault)
+            try:
+                lab.fault(fault)
+                lab.issue(0x02000888, 0)
+                ext = lab.drain()
+                assert len(ext) == 512 and ext[index] == expected
+                assert lab.state()["backend_reads"] == 0
+            finally:
+                lab.close()
+
+        lab = instance("absent", False)
+        try:
+            assert lab.state() == {"enabled": False}
+        finally:
+            lab.close()
+        assert hashlib.sha256(image.read_bytes()).digest() == digest
+    print("PASS: synthetic inherited MSDC PIO, real read-only sectors, EXT_CSD, faults and absence")
+
+
+if __name__ == "__main__":
+    main()
