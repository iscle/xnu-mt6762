diff --git a/hw/misc/mt6762_sspm_lab.c b/hw/misc/mt6762_sspm_lab.c
new file mode 100644
index 0000000..34e8abf
--- /dev/null
+++ b/hw/misc/mt6762_sspm_lab.c
@@ -0,0 +1,165 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * AI-assisted local experiment; not intended for upstream submission.
+ *
+ * Opt-in synthetic SSPM PLATFORM mailbox fixture. Stock DT and kernel define
+ * addresses, pin/slot layout and 0xDEAD liveness command. Immediate responses,
+ * fixed alive=1, and injected failures are test assumptions, not firmware.
+ * No SSPM instructions, CPU-DVFS commands, rails, clocks, notifications or
+ * IRQ delivery are emulated. Unknown commands receive no fabricated success.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/misc/mt6762_sspm_lab.h"
+#include "system/reset.h"
+
+typedef struct SSPMBlock {
+    MT6762SSPMLab *sspm;
+    MemoryRegion region;
+    bool control;
+} SSPMBlock;
+struct MT6762SSPMLab {
+    SSPMBlock data, control;
+    uint32_t words[64], in_irq, out_irq, last_command;
+    unsigned fault;
+    uint64_t reads, data_writes, control_writes, requests, responses;
+    uint64_t ack_clears, rejected_commands, rejected_writes;
+};
+
+static uint64_t sspm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    SSPMBlock *block = opaque;
+    MT6762SSPMLab *s = block->sspm;
+    s->reads++;
+    if (!block->control) {
+        return s->words[offset / 4];
+    }
+    if (offset == 0) {
+        return s->in_irq |
+            (s->fault == MT6762_SSPM_FAULT_STALE_INPUT ? 1 : 0);
+    }
+    return s->out_irq |
+        (s->fault == MT6762_SSPM_FAULT_STALE_ACK ? 1 : 0);
+}
+
+static void platform_command(MT6762SSPMLab *s)
+{
+    s->requests++;
+    s->last_command = s->words[0];
+    if (s->words[0] != 0xdead || s->words[1] || s->words[2]) {
+        s->rejected_commands++;
+        qemu_log_mask(LOG_GUEST_ERROR,
+            "mt6762 lab SSPM: unsupported PLATFORM command %#x\n", s->words[0]);
+        return;
+    }
+    if (s->fault == MT6762_SSPM_FAULT_TIMEOUT) {
+        return;
+    }
+    s->words[0] = s->fault == MT6762_SSPM_FAULT_DEAD ? 0 : 1;
+    if (s->fault != MT6762_SSPM_FAULT_INPUT_STUCK) {
+        s->in_irq &= ~1u;
+    }
+    s->out_irq |= s->fault == MT6762_SSPM_FAULT_WRONG_ACK ? 2 : 1;
+    s->responses++;
+}
+
+static void sspm_write(void *opaque, hwaddr offset, uint64_t value,
+                       unsigned size)
+{
+    SSPMBlock *block = opaque;
+    MT6762SSPMLab *s = block->sspm;
+    uint32_t bits = value;
+    if (!block->control) {
+        s->words[offset / 4] = bits;
+        s->data_writes++;
+        return;
+    }
+    s->control_writes++;
+    if (offset == 4) {
+        s->ack_clears++;
+        if (s->fault != MT6762_SSPM_FAULT_ACK_STUCK) {
+            s->out_irq &= ~bits; /* W1C: preserve every other channel. */
+        }
+        return;
+    }
+    if (bits & ~3u) {
+        s->rejected_writes++;
+        qemu_log_mask(LOG_UNIMP, "mt6762 lab SSPM: unsupported doorbell %#x\n",
+                      bits);
+        return;
+    }
+    uint32_t pending = s->in_irq | s->out_irq;
+    if (s->fault == MT6762_SSPM_FAULT_STALE_ACK ||
+        s->fault == MT6762_SSPM_FAULT_STALE_INPUT) {
+        pending |= 1;
+    }
+    if (bits & pending) {
+        s->rejected_writes++;
+        return;
+    }
+    s->in_irq |= bits;
+    if (bits & 1) {
+        platform_command(s);
+    }
+    if (bits & 2) {
+        /* The CPU mailbox layout is present, but no DVFS firmware exists. */
+        s->rejected_commands++;
+        qemu_log_mask(LOG_UNIMP,
+            "mt6762 lab SSPM: CPU-DVFS command %#x is not emulated\n", s->words[3]);
+    }
+}
+static const MemoryRegionOps sspm_ops = {
+    .read = sspm_read,
+    .write = sspm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+static void sspm_reset(void *opaque)
+{
+    MT6762SSPMLab *s = opaque;
+    memset(s->words, 0, sizeof(s->words));
+    s->in_irq = s->out_irq = s->last_command = 0;
+    s->reads = s->data_writes = s->control_writes = 0;
+    s->requests = s->responses = s->ack_clears = 0;
+    s->rejected_commands = s->rejected_writes = 0;
+}
+void mt6762_sspm_lab_configure(MT6762SSPMLab *s, unsigned fault)
+{
+    assert(fault < MT6762_SSPM_FAULT_COUNT);
+    s->fault = fault;
+}
+char *mt6762_sspm_lab_state(MT6762SSPMLab *s)
+{
+    if (!s) {
+        return g_strdup("{\"enabled\":false}");
+    }
+    return g_strdup_printf("{\"enabled\":true,\"synthetic\":true,"
+        "\"dvfs_emulated\":false,\"fault\":%u,\"in_irq\":%u,\"out_irq\":%u,"
+        "\"last_command\":%u,\"requests\":%" PRIu64 ",\"responses\":%" PRIu64
+        ",\"ack_clears\":%" PRIu64 ",\"reads\":%" PRIu64
+        ",\"data_writes\":%" PRIu64 ",\"control_writes\":%" PRIu64
+        ",\"rejected_commands\":%" PRIu64 ",\"rejected_writes\":%" PRIu64 "}",
+        s->fault,
+        s->in_irq | (s->fault == MT6762_SSPM_FAULT_STALE_INPUT ? 1 : 0),
+        s->out_irq | (s->fault == MT6762_SSPM_FAULT_STALE_ACK ? 1 : 0),
+        s->last_command, s->requests,
+        s->responses, s->ack_clears, s->reads, s->data_writes,
+        s->control_writes, s->rejected_commands, s->rejected_writes);
+}
+MT6762SSPMLab *mt6762_sspm_lab_create(Object *owner, MemoryRegion *memory)
+{
+    MT6762SSPMLab *s = g_new0(MT6762SSPMLab, 1);
+    s->data.sspm = s;
+    s->control.sspm = s;
+    s->control.control = true;
+    memory_region_init_io(&s->data.region, owner, &sspm_ops, &s->data,
+                          "mt6762.lab-sspm-data", 0x100);
+    memory_region_init_io(&s->control.region, owner, &sspm_ops, &s->control,
+                          "mt6762.lab-sspm-control", 8);
+    memory_region_add_subregion(memory, 0x10450000, &s->data.region);
+    memory_region_add_subregion(memory, 0x10451000, &s->control.region);
+    sspm_reset(s);
+    qemu_register_reset(sspm_reset, s);
+    return s;
+}
