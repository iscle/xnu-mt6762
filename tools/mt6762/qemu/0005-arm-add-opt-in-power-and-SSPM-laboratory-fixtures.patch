@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""Paused QEMU SSPM fixture tests; no physical device access or DVFS proof."""
+import argparse
+import json
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import time
+
+
+class Lab:
+    def __init__(self, qemu, dtb, directory, enabled=True):
+        directory = Path(directory)
+        self.log = (directory / "qemu.log").open("w+")
+        self.qmp_path = directory / "qmp.sock"
+        self.test_path = directory / "qtest.sock"
+        machine = "mt6762"
+        if enabled:
+            machine += ",lab-sspm=on"
+        self.process = subprocess.Popen([
+            str(qemu), "-M", machine, "-accel", "tcg", "-cpu", "cortex-a53",
+            "-m", "512M", "-smp", "1", "-dtb", str(dtb), "-S",
+            "-display", "none", "-serial", "null", "-monitor", "none",
+            "-qmp", f"unix:{self.qmp_path},server=on,wait=off",
+            "-qtest", f"unix:{self.test_path},server=on,wait=off",
+        ], stdout=self.log, stderr=self.log)
+        self.sockets = []
+        try:
+            self.qmp = self.connect(self.qmp_path)
+            self.test = self.connect(self.test_path)
+            assert "QMP" in json.loads(self.qmp.readline())
+            self.command("qmp_capabilities")
+        except BaseException:
+            self.close()
+            raise
+
+    def connect(self, path):
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline:
+            if self.process.poll() is not None:
+                self.log.seek(0)
+                raise RuntimeError(self.log.read())
+            sock = socket.socket(socket.AF_UNIX)
+            sock.settimeout(5)
+            try:
+                sock.connect(str(path))
+            except (FileNotFoundError, ConnectionRefusedError):
+                sock.close()
+                time.sleep(0.02)
+                continue
+            self.sockets.append(sock)
+            return sock.makefile("rwb", buffering=0)
+        raise TimeoutError(f"QEMU socket {path.name} did not appear")
+
+    def command(self, command, **arguments):
+        self.qmp.write((json.dumps({"execute": command, "arguments": arguments}) + "\n").encode())
+        while True:
+            answer = json.loads(self.qmp.readline())
+            if "event" in answer:
+                continue
+            if "error" in answer:
+                raise RuntimeError(answer["error"])
+            return answer.get("return")
+
+    def state(self):
+        return json.loads(self.command("qom-get", path="/machine", property="lab-sspm-state"))
+
+    def fault(self, name):
+        self.command("qom-set", path="/machine", property="lab-sspm-fault", value=name)
+
+    def access(self, text):
+        self.test.write((text + "\n").encode())
+        reply = self.test.readline().decode().strip()
+        if not reply.startswith("OK"):
+            raise RuntimeError(reply)
+        return reply[2:].strip()
+
+    def read(self, address):
+        return int(self.access(f"readl {address:#x}"), 0)
+
+    def write(self, address, value):
+        self.access(f"writel {address:#x} {value:#x}")
+
+    def close(self):
+        if self.process.poll() is None:
+            self.process.terminate()
+            try:
+                self.process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait(timeout=5)
+        for name in ["qmp", "test"]:
+            stream = getattr(self, name, None)
+            if stream:
+                stream.close()
+        for sock in self.sockets:
+            sock.close()
+        self.log.close()
+
+
+DATA, IN, OUT = 0x10450000, 0x10451000, 0x10451004
+
+def request(lab, command=0xdead, arguments=(0, 0)):
+    lab.write(DATA, command)
+    lab.write(DATA + 4, arguments[0])
+    lab.write(DATA + 8, arguments[1])
+    lab.write(IN, 1)
+
+
+def reset(lab, fault="none"):
+    lab.command("system_reset")
+    lab.fault(fault)
+
+
+def exercise(lab):
+    assert lab.state()["synthetic"] and not lab.state()["dvfs_emulated"]
+    request(lab)
+    assert lab.read(IN) == 0 and lab.read(OUT) == 1 and lab.read(DATA) == 1
+    lab.write(OUT, 1)
+    assert lab.read(OUT) == 0
+    assert lab.state()["requests"] == lab.state()["responses"] == 1
+    assert lab.state()["ack_clears"] == 1
+    # An ACK on another pin must survive clearing only the PLATFORM pin.
+    reset(lab, "wrong-ack")
+    request(lab)
+    assert lab.read(IN) == 0 and lab.read(OUT) == 2
+    lab.fault("none")
+    request(lab)
+    assert lab.read(OUT) == 3
+    lab.write(OUT, 1)
+    assert lab.read(OUT) == 2
+    lab.write(OUT, 2)
+    assert lab.read(OUT) == 0
+    # Pending inherited status is visible without modifying it.
+    for fault, register in [("stale-ack", OUT), ("stale-input", IN)]:
+        reset(lab, fault)
+        assert lab.read(register) == 1
+        state = lab.state()
+        assert state["data_writes"] == state["control_writes"] == state["requests"] == 0
+        lab.write(IN, 1)
+        assert lab.state()["rejected_writes"] == 1 and lab.state()["requests"] == 0
+    reset(lab, "timeout")
+    request(lab)
+    for _ in range(10):
+        assert lab.read(IN) == 1 and lab.read(OUT) == 0
+    assert lab.state()["requests"] == 1 and lab.state()["responses"] == 0
+    reset(lab, "input-stuck")
+    request(lab)
+    assert lab.read(IN) == 1 and lab.read(OUT) == 1 and lab.read(DATA) == 1
+    reset(lab, "ack-stuck")
+    request(lab)
+    lab.write(OUT, 1)
+    assert lab.read(IN) == 0 and lab.read(OUT) == 1
+    reset(lab, "dead")
+    request(lab)
+    assert lab.read(IN) == 0 and lab.read(OUT) == 1 and lab.read(DATA) == 0
+    # No success is fabricated for an unsupported PLATFORM command or args.
+    for command, args in [(1, (0, 0)), (0xdead, (1, 0))]:
+        reset(lab)
+        request(lab, command, args)
+        assert lab.read(IN) == 1 and lab.read(OUT) == 0
+        assert lab.state()["rejected_commands"] == 1 and lab.state()["responses"] == 0
+    reset(lab)
+    for i, value in enumerate([0, 0, 0, 0]):
+        lab.write(DATA + 12 + 4*i, value)
+    lab.write(IN, 2)
+    assert lab.read(IN) == 2 and lab.read(OUT) == 0
+    assert lab.state()["rejected_commands"] == 1 and not lab.state()["dvfs_emulated"]
+    return lab.state()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qemu", required=True, type=Path)
+    parser.add_argument("--dtb", required=True, type=Path)
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix="mt6762-sspm-qtest-") as directory:
+        lab = Lab(args.qemu.resolve(), args.dtb.resolve(), directory)
+        try:
+            result = exercise(lab)
+        finally:
+            lab.close()
+        lab = Lab(args.qemu.resolve(), args.dtb.resolve(), directory, enabled=False)
+        try:
+            assert lab.state() == {"enabled": False}
+            assert lab.read(DATA) == lab.read(IN) == lab.read(OUT) == 0
+        finally:
+            lab.close()
+    print(json.dumps({"synthetic_only": True, "passed": True, "final_fixture_state": result}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
-- 
