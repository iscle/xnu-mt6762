diff --git a/hw/arm/mt6762_lab_power.c b/hw/arm/mt6762_lab_power.c
new file mode 100644
index 0000000..3c9da69
--- /dev/null
+++ b/hw/arm/mt6762_lab_power.c
@@ -0,0 +1,202 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * AI-assisted local experiment; not intended for upstream submission.
+ *
+ * Opt-in synthetic PWRAP WACS2/MT6357 ADC/keypad protocol fixture.
+ * Register addresses follow the supplied BSP and native consumer. Fixed ADC
+ * values, initial state and completion delays are test assumptions. This is
+ * not a PMIC electrical, charging, battery, interrupt or power-domain model.
+ * The only supported PMIC writes request ADC channels1 and3. No rail writes.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "system/reset.h"
+#include "hw/arm/mt6762_lab_power.h"
+
+struct MT6762PowerLab {
+    MemoryRegion pwrap, keypad;
+    QEMUTimer *transaction, *adc[2];
+    unsigned fault, keys, fsm;
+    uint32_t command;
+    uint16_t data, adc_data[2];
+    uint64_t commands, reads, writes, rejected, clears, key_reads;
+    uint64_t adc_requests[2], adc_completions[2];
+};
+
+static void adc_complete(MT6762PowerLab *s, unsigned channel)
+{
+    if (s->fault == MT6762_POWER_FAULT_ADC_TIMEOUT ||
+        s->fault == MT6762_POWER_FAULT_INIT_LOSS) {
+        return;
+    }
+    s->adc_data[channel] = 0x8000 |
+        (s->fault == MT6762_POWER_FAULT_ADC_RAIL ? 0 :
+         channel == 0 ? 26700 : 1400);
+    s->adc_completions[channel]++;
+}
+static void adc0_complete(void *opaque) { adc_complete(opaque, 0); }
+static void adc1_complete(void *opaque) { adc_complete(opaque, 1); }
+
+static uint16_t pmic_read(MT6762PowerLab *s, uint16_t address)
+{
+    switch (address) {
+    case 0x0008:
+        return s->fault == MT6762_POWER_FAULT_BAD_ID ? 0x1234 : 0x5730;
+    case 0x0024:
+        return 4 | ((s->keys & 1) ? 0 : 2); /* VBUS present; power active-low */
+    case 0x0e08:
+        return 1; /* BATON detection enabled, battery present */
+    case 0x108a:
+        return s->adc_data[0];
+    case 0x108e:
+        return s->adc_data[1];
+    }
+    s->rejected++;
+    qemu_log_mask(LOG_UNIMP, "mt6762 power fixture unsupported PMIC read %#x\n",
+                  address);
+    return 0xffff;
+}
+static void pmic_write(MT6762PowerLab *s, uint16_t address, uint16_t data)
+{
+    if (address == 0x110e && (data == 2 || data == 8)) {
+        unsigned channel = data == 2 ? 0 : 1;
+        s->adc_data[channel] = 0;
+        s->adc_requests[channel]++;
+        timer_mod(s->adc[channel], qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (channel == 0 ? 1280000 : 80000));
+        return;
+    }
+    s->rejected++;
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "mt6762 power fixture rejects PMIC write %#x=%#x\n",
+                  address, data);
+}
+static void transaction_complete(void *opaque)
+{
+    MT6762PowerLab *s = opaque;
+    uint16_t address = (s->command >> 16) << 1;
+    if (s->fault == MT6762_POWER_FAULT_STALL ||
+        s->fault == MT6762_POWER_FAULT_INIT_LOSS) {
+        return;
+    }
+    if (s->command & 0x80000000u) {
+        pmic_write(s, address, s->command);
+        s->writes++;
+        s->fsm = 0;
+    } else {
+        s->data = pmic_read(s, address);
+        s->reads++;
+        s->fsm = 6;
+    }
+}
+static uint64_t pwrap_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MT6762PowerLab *s = opaque;
+    if (offset == 0xc24) {
+        return (s->fault == MT6762_POWER_FAULT_INIT_LOSS ? 0 : 1u << 21) |
+               (s->fsm << 16) | s->data;
+    }
+    return 0;
+}
+static void pwrap_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    MT6762PowerLab *s = opaque;
+    if (offset == 0xc28 && value == 1 && s->fsm == 6) {
+        s->fsm = 0;
+        s->data = 0;
+        s->clears++;
+        return;
+    }
+    if (offset == 0xc20 && s->fsm == 0 &&
+        s->fault != MT6762_POWER_FAULT_INIT_LOSS) {
+        s->command = value;
+        s->fsm = 2;
+        s->commands++;
+        timer_mod(s->transaction, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 10000);
+        return;
+    }
+    s->rejected++;
+}
+static uint64_t keypad_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MT6762PowerLab *s = opaque;
+    s->key_reads++;
+    if (offset == 0x24) {
+        return s->fault == MT6762_POWER_FAULT_KEYPAD_DISABLED ? 0 : 1;
+    }
+    if (offset == 4) {
+        return 0xffff & ~((s->keys & 2 ? 2 : 0) | (s->keys & 4 ? 1 : 0));
+    }
+    if (offset >= 8 && offset <= 0x14) {
+        return 0xffff;
+    }
+    return 0;
+}
+static void keypad_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    MT6762PowerLab *s = opaque;
+    s->rejected++; /* No keypad setup or interrupt programming */
+}
+static const MemoryRegionOps pwrap_ops = {
+    .read = pwrap_read, .write = pwrap_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+static const MemoryRegionOps keypad_ops = {
+    .read = keypad_read, .write = keypad_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 2, .max_access_size = 2 },
+    .impl = { .min_access_size = 2, .max_access_size = 2 },
+};
+static void power_reset(void *opaque)
+{
+    MT6762PowerLab *s = opaque;
+    timer_del(s->transaction);
+    for (unsigned i = 0; i < 2; i++) {
+        timer_del(s->adc[i]);
+        s->adc_data[i] = 0;
+        s->adc_requests[i] = s->adc_completions[i] = 0;
+    }
+    s->keys = s->fsm = s->command = s->data = 0;
+    s->commands = s->reads = s->writes = s->rejected = s->clears = s->key_reads = 0;
+}
+MT6762PowerLab *mt6762_lab_power_create(Object *owner, MemoryRegion *memory)
+{
+    MT6762PowerLab *s = g_new0(MT6762PowerLab, 1);
+    s->transaction = timer_new_ns(QEMU_CLOCK_VIRTUAL, transaction_complete, s);
+    s->adc[0] = timer_new_ns(QEMU_CLOCK_VIRTUAL, adc0_complete, s);
+    s->adc[1] = timer_new_ns(QEMU_CLOCK_VIRTUAL, adc1_complete, s);
+    memory_region_init_io(&s->pwrap, owner, &pwrap_ops, s,
+                          "mt6762-lab-pwrap", 0x1000);
+    memory_region_init_io(&s->keypad, owner, &keypad_ops, s,
+                          "mt6762-lab-keypad", 0x1000);
+    memory_region_add_subregion(memory, 0x1000d000, &s->pwrap);
+    memory_region_add_subregion(memory, 0x10010000, &s->keypad);
+    power_reset(s);
+    qemu_register_reset(power_reset, s);
+    return s;
+}
+void mt6762_lab_power_configure(MT6762PowerLab *s, unsigned fault)
+{
+    s->fault = fault < MT6762_POWER_FAULT_COUNT ? fault : MT6762_POWER_FAULT_NONE;
+}
+void mt6762_lab_power_set_keys(MT6762PowerLab *s, unsigned mask)
+{
+    s->keys = mask & 7;
+}
+char *mt6762_lab_power_state(MT6762PowerLab *s)
+{
+    if (!s) {
+        return g_strdup("{\"enabled\":false}");
+    }
+    return g_strdup_printf("{\"enabled\":true,\"synthetic\":true,"
+        "\"fault\":%u,\"key_mask\":%u,\"fsm\":%u,"
+        "\"commands\":%" PRIu64 ",\"reads\":%" PRIu64 ","
+        "\"writes\":%" PRIu64 ",\"rejected\":%" PRIu64 ","
+        "\"clears\":%" PRIu64 ",\"key_reads\":%" PRIu64 ","
+        "\"adc_requests\":[%" PRIu64 ",%" PRIu64 "],"
+        "\"adc_completions\":[%" PRIu64 ",%" PRIu64 "]}",
+        s->fault, s->keys, s->fsm, s->commands, s->reads, s->writes,
+        s->rejected, s->clears, s->key_reads, s->adc_requests[0],
+        s->adc_requests[1], s->adc_completions[0], s->adc_completions[1]);
+}
