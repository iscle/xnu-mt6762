 static void adc_complete(MT6762PowerLab *s, unsigned channel)
 {
-    static const uint16_t values[5] = { 26700, 1400, 1588, 1526, 1534 };
+    static const uint16_t values[6] = { 26700, 1400, 1588, 1526, 1534, 4089 };
