diff --git a/tests/mt6762/test_lab_bif.py b/tests/mt6762/test_lab_bif.py
new file mode 100644
index 0000000..af69071
--- /dev/null
+++ b/tests/mt6762/test_lab_bif.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Opt-in raw BIF fixture; paused CPU, no real PMIC or temperature calibration."""
+import argparse,tempfile
+from pathlib import Path
+from test_lab_power import PowerLab
+
+def main():
+ p=argparse.ArgumentParser(description=__doc__)
+ p.add_argument('--qemu',type=Path,required=True);p.add_argument('--dtb',type=Path,required=True)
+ a=p.parse_args()
+ for fault in ['none','bif-tdet-set','bif-config','bif-timeout','bif-stale',
+               'bif-rail','bif-tdet-changed','adc-stale','absent']:
+  with tempfile.TemporaryDirectory(prefix='mt6762-bif-qtest-') as d:
+   lab=PowerLab(a.qemu.resolve(),a.dtb.resolve(),d,bif=fault!='absent')
+   try:
+    if fault=='absent':
+     assert not lab.state()['bif_enabled'] and lab.pmic(0x109e)==0xffff
+     n=lab.state()['rejected'];lab.pmic(0x110e,2048)
+     assert lab.state()['rejected']==n+1
+     continue
+    lab.fault(fault)
+    assert lab.pmic(0x1236)==(6 if fault=='bif-tdet-set' else 4)
+    assert lab.pmic(0x10de)==(0x4001 if fault=='bif-config' else 0x4000)
+    for reg in [0x10e0,0x1120,0x1126,0x1128,0x112e,0x1132,0x1136,0x113a,0x113c]:
+     assert lab.pmic(reg)==0
+    lab.pmic(0x110e,8)
+    assert bool(lab.pmic(0x108e)&0x8000)==(fault=='adc-stale')
+    lab.step(80000);assert lab.pmic(0x108e)==0x8000|1400
+    lab.pmic(0x110e,2048)
+    assert bool(lab.pmic(0x109e)&0x8000)==(fault=='bif-stale')
+    lab.step(80000)
+    value=lab.pmic(0x109e)
+    assert value==(0 if fault=='bif-timeout' else 0x8000 if fault=='bif-rail' else 0x8000|4089)
+    assert lab.pmic(0x1236)==(6 if fault in ['bif-tdet-set','bif-tdet-changed'] else 4)
+    state=lab.state();assert state['bif_requests']==1
+    assert state['bif_completions']==(0 if fault=='bif-timeout' else 1)
+    assert state['bif_tdet_write_attempts']==0
+    n=state['rejected'];before=lab.pmic(0x1236)
+    lab.pmic(0x1236,0);lab.pmic(0x10de,0)
+    assert lab.pmic(0x1236)==before and lab.state()['rejected']==n+2
+    assert lab.state()['bif_tdet_write_attempts']==1
+   finally:lab.close()
+ with tempfile.TemporaryDirectory(prefix='mt6762-bif-slow-qtest-') as d:
+  lab=PowerLab(a.qemu.resolve(),a.dtb.resolve(),d,bif=True,adc_delay_us=2000)
+  try:
+   assert lab.state()['adc_delay_us']==2000
+   for request,address,raw in [(8,0x108e,1400),(2048,0x109e,4089)]:
+    lab.pmic(0x110e,request);lab.step(80000)
+    assert not lab.pmic(address)&0x8000
+    lab.step(2000000);assert lab.pmic(address)==0x8000|raw
+   assert lab.state()['bif_tdet_write_attempts']==0
+  finally:lab.close()
+ print('PASS: synthetic BIF generation, faults, immutable TDET/trim and default absence')
+if __name__=='__main__':main()
