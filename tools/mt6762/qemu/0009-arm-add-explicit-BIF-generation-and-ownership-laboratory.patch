         s->fault == MT6762_POWER_FAULT_INIT_LOSS ||
-        (channel >= 2 && (!s->thermal_enabled ||
-         s->fault == MT6762_POWER_FAULT_THERMAL_TIMEOUT))) {
+        (channel >= 2 && channel < 5 && (!s->thermal_enabled ||
+         s->fault == MT6762_POWER_FAULT_THERMAL_TIMEOUT)) ||
+        (channel == 5 && (!s->bif_enabled ||
