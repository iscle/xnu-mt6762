From 1cefe6067521f188fffbe2070bd520501a8c60fe Mon Sep 17 00:00:00 2001
From: MT6762 local experiment <mt6762-build@localhost>
Date: Fri, 23 Oct 2026 23:50:48 +0200
Subject: [PATCH] arm: add explicit AXS packet override for native gesture
 tests

AI-assisted local experiment, not intended for upstream submission. Allows opt-in QMP packets to traverse modeled I2C/DMA and the native guest worker instead of injecting into a guest event queue. Preserves default fixture behavior and validates setters atomically.
---
 docs/system/arm/mt6762.rst       | 16 ++++++++
 hw/arm/mt6762_lab_i2c.c          | 59 ++++++++++++++++++++++++++++
 tests/mt6762/test_lab_display.py |  7 ++--
 tests/mt6762/test_lab_touch.py   | 67 ++++++++++++++++++++++++++++++++
 4 files changed, 146 insertions(+), 3 deletions(-)
 create mode 100644 tests/mt6762/test_lab_touch.py

diff --git a/docs/system/arm/mt6762.rst b/docs/system/arm/mt6762.rst
index f2e5bea..579dca0 100644
--- a/docs/system/arm/mt6762.rst
+++ b/docs/system/arm/mt6762.rst
@@ -206,3 +206,19 @@ arguments as above. Native-loader options ``--native-lab-power`` and
 ``--native-lab-sspm`` grant only the corresponding synthetic ownership and
 verification assertions. Their successful guest execution is distinct from
 real phone power, battery, buttons or SSPM firmware validation.
+
+Consumed synthetic AXS gestures
+------------------------------
+
+When ``lab-i2c`` is enabled, QMP ``qom-set`` can set ``lab-touch-frame`` on
+``/machine`` to exactly64 hexadecimal digits. Each subsequent AXS32-byte
+DMA read returns that packet. A zero-contact packet releases all contacts;
+an empty string restores the original sequence/default behavior. Invalid
+values leave the current packet unchanged. This property is a test-only
+peripheral response override, not an input-queue injection interface.
+
+``tests/mt6762/test_lab_touch.py`` tests exact five-contact packet DMA,
+release, rejected malformed setters and restoration of default behavior.
+The source-only XNU helper ``touch_lab.py`` waits for two completed native
+DMA reads after each published frame before advancing a gesture. Model
+counters still represent synthetic I2C traffic, not real touch hardware.
diff --git a/hw/arm/mt6762_lab_i2c.c b/hw/arm/mt6762_lab_i2c.c
index bfcc92d..f238c52 100644
--- a/hw/arm/mt6762_lab_i2c.c
+++ b/hw/arm/mt6762_lab_i2c.c
@@ -11,6 +11,7 @@
 #include "qemu/log.h"
 #include "qemu/timer.h"
 #include "qapi/error.h"
+#include "qapi/visitor.h"
 #include "hw/arm/mt6762_lab_i2c.h"
 #include "system/address-spaces.h"
 #include "system/reset.h"
@@ -48,6 +49,8 @@ struct MT6762I2CLab {
     uint32_t gates[2], mux;
     unsigned fault;
     bool touch, display;
+    bool touch_override;
+    uint8_t touch_frame[32];
 };
 
 static void lab_irq(MT6762I2CBus *s)
@@ -89,6 +92,10 @@ static unsigned lab_endpoint(MT6762I2CBus *s, unsigned address,
         if (nt || nr != 32) {
             return ACKERR;
         }
+        if (s->lab->touch_override) {
+            memcpy(rx, s->lab->touch_frame, sizeof(s->lab->touch_frame));
+            return 0;
+        }
         unsigned frame = s->frames++ % 64;
         if (s->lab->touch) {
             /* 8-ms polling: down, held/moved, then an explicit zero frame. */
@@ -388,6 +395,8 @@ static void lab_reset(void *opaque)
     s->gates[0] = BIT(11);
     s->gates[1] = BIT(18);
     s->mux = 0;
+    s->touch_override = false;
+    memset(s->touch_frame, 0, sizeof(s->touch_frame));
     for (i = 0; i < 2; i++) {
         MT6762I2CBus *b = &s->bus[i];
         timer_del(b->timer);
@@ -435,6 +444,54 @@ char *mt6762_lab_i2c_state(MT6762I2CLab *s)
         s->bus[1].psc[1], s->bus[1].psc[0]);
 }
 
+/* Runtime-only laboratory input. Bytes travel through the actual guest
+ * controller/DMA/parser; this never posts directly into an XNU input queue.
+ * Empty string restores the existing deterministic-sequence mode. */
+static void lab_touch_frame_get(Object *owner, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    MT6762I2CLab *s = opaque;
+    g_autofree char *value = g_malloc0(65);
+    unsigned i;
+    if (s->touch_override) {
+        for (i = 0; i < sizeof(s->touch_frame); i++) {
+            snprintf(value + i * 2, 3, "%02x", s->touch_frame[i]);
+        }
+    }
+    visit_type_str(v, name, &value, errp);
+}
+
+static void lab_touch_frame_set(Object *owner, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    MT6762I2CLab *s = opaque;
+    g_autofree char *value = NULL;
+    uint8_t frame[32];
+    unsigned i;
+    if (!visit_type_str(v, name, &value, errp)) {
+        return;
+    }
+    if (!value[0]) {
+        s->touch_override = false;
+        return;
+    }
+    if (strlen(value) != sizeof(frame) * 2) {
+        error_setg(errp, "lab-touch-frame needs exactly 32 hex-encoded bytes");
+        return;
+    }
+    for (i = 0; i < sizeof(frame); i++) {
+        int high = g_ascii_xdigit_value(value[i * 2]);
+        int low = g_ascii_xdigit_value(value[i * 2 + 1]);
+        if (high < 0 || low < 0) {
+            error_setg(errp, "lab-touch-frame contains a non-hex digit");
+            return;
+        }
+        frame[i] = high * 16 + low;
+    }
+    memcpy(s->touch_frame, frame, sizeof(frame));
+    s->touch_override = true;
+}
+
 MT6762I2CLab *mt6762_lab_i2c_create(Object *owner, MemoryRegion *memory,
                                   uint64_t ram_size, qemu_irq irq0, qemu_irq irq5)
 {
@@ -466,6 +523,8 @@ MT6762I2CLab *mt6762_lab_i2c_create(Object *owner, MemoryRegion *memory,
                           "mt6762.lab-gpio-fixture", 0x1000);
     memory_region_add_subregion(memory, 0x10005000, &s->gpio_mmio);
     lab_reset(s);
+    object_property_add(owner, "lab-touch-frame", "str", lab_touch_frame_get,
+                        lab_touch_frame_set, NULL, s);
     qemu_register_reset(lab_reset, s);
     return s;
 }
