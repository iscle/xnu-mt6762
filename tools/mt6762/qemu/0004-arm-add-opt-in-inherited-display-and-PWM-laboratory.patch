 include/hw/arm/mt6762_lab_display.h |  19 +++
 include/hw/arm/mt6762_lab_i2c.h     |   1 +
 tests/mt6762/test_lab_display.py    | 191 +++++++++++++++++++++++++
 8 files changed, 561 insertions(+), 5 deletions(-)
