diff --git a/hw/arm/mt6762_lab_display.c b/hw/arm/mt6762_lab_display.c
new file mode 100644
index 0000000..89c24f5
--- /dev/null
+++ b/hw/arm/mt6762_lab_display.c
@@ -0,0 +1,208 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * AI-assisted local experiment; not intended for upstream submission.
+ *
+ * Explicit synthetic inherited-display fixture for native-consumer tests.
+ * The supplied MT6765 BSP defines these register offsets; fixed pipeline
+ * contents and PWM latching are test assumptions, not physical observations.
+ * No DSI packets, panel, DMA fetch, SMI/IOMMU, pixel scanout or real clocks are
+ * emulated. The framebuffer remains ordinary guest RAM observed by host tools.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/arm/mt6762_lab_display.h"
+#include "system/reset.h"
+
+enum { SPM, MMSYS, OVL, RDMA, DSI, PWM, BLOCKS };
+typedef struct DisplayBlock {
+    MT6762DisplayLab *display;
+    MemoryRegion region;
+    unsigned id;
+} DisplayBlock;
+struct MT6762DisplayLab {
+    DisplayBlock blocks[BLOCKS];
+    uint64_t framebuffer_pa, reads[BLOCKS], pwm_writes, commits, rejected_writes;
+    unsigned fault, applied_level;
+    uint32_t pwm_enable, pwm_con0, pwm_con1, pwm_commit;
+};
+
+static uint64_t display_read(void *opaque, hwaddr offset, unsigned size)
+{
+    DisplayBlock *block = opaque;
+    MT6762DisplayLab *s = block->display;
+    s->reads[block->id]++;
+    switch (block->id) {
+    case SPM:
+        if (offset == 0x180 || offset == 0x184) {
+            return s->fault == MT6762_DISPLAY_FAULT_POWER_OFF ? 0 : 8;
+        }
+        if (offset == 0x30c) {
+            return s->fault == MT6762_DISPLAY_FAULT_POWER_OFF ? 0x1112 : 13;
+        }
+        break;
+    case MMSYS:
+        if (offset == 0x100) {
+            return s->fault == MT6762_DISPLAY_FAULT_POWER_OFF ? UINT32_MAX : 0;
+        }
+        break;
+    case OVL:
+        switch (offset) {
+        case 0x00c: case 0x02c: case 0x0c0: return 1;
+        case 0x020: case 0x038: return 384 | (854u << 16);
+        case 0x030: return 0x20ff; /* BGRA8888, memory source, alpha disabled */
+        case 0x044: return 1536;
+        case 0xf40:
+            return s->framebuffer_pa +
+                (s->fault == MT6762_DISPLAY_FAULT_SCANOUT ? 0x4000 : 0);
+        case 0x03c: case 0x04c: case 0x324: return 0;
+        }
+        break;
+    case RDMA:
+        if (offset == 0x010) {
+            return 1; /* Engine on, direct-link mode */
+        }
+        break;
+    case DSI:
+        switch (offset) {
+        case 0x000: return 1;
+        case 0x014: return 2; /* SYNC_EVENT_VDO */
+        case 0x018: return 7u << 2; /* Three-lane bit mask */
+        case 0x01c: return (2u << 16) | 1152; /* RGB888,384*3 bytes */
+        case 0x020: return 2;
+        case 0x024: return 20;
+        case 0x028: return 170;
+        case 0x02c: return 854;
+        }
+        break;
+    case PWM:
+        switch (offset) {
+        case 0x000: return s->pwm_enable;
+        case 0x00c: return s->pwm_commit;
+        case 0x018: return s->pwm_con0;
+        case 0x01c: return s->pwm_con1;
+        }
+        break;
+    }
+    qemu_log_mask(LOG_UNIMP, "mt6762 lab display block%u read %#" HWADDR_PRIx "\n",
+                  block->id, offset);
+    return 0;
+}
+
+static void display_write(void *opaque, hwaddr offset, uint64_t value,
+                          unsigned size)
+{
+    DisplayBlock *block = opaque;
+    MT6762DisplayLab *s = block->display;
+    if (block->id != PWM) {
+        s->rejected_writes++;
+        qemu_log_mask(LOG_UNIMP,
+            "mt6762 lab inherited display rejects programming block%u offset%#"
+            HWADDR_PRIx "\n", block->id, offset);
+        return;
+    }
+    s->pwm_writes++;
+    if (s->fault == MT6762_DISPLAY_FAULT_PWM_DROP ||
+        s->fault == MT6762_DISPLAY_FAULT_POWER_OFF) {
+        return;
+    }
+    switch (offset) {
+    case 0x000:
+        s->pwm_enable = value;
+        return;
+    case 0x018:
+        s->pwm_con0 = value;
+        return;
+    case 0x01c:
+        s->pwm_con1 = value;
+        return;
+    case 0x00c:
+        if (value > 1) {
+            s->rejected_writes++;
+            return;
+        }
+        if (s->pwm_commit == 1 && value == 0) {
+            unsigned duty = (s->pwm_con1 >> 16) & 0x1fff;
+            /* Test fixture only latches the bounded stock configuration. */
+            if (((s->pwm_con0 >> 16) & 1023) == 3 &&
+                (s->pwm_con1 & 1023) == 1023 && duty <= 1023) {
+                s->applied_level = (s->pwm_enable & 1) ? duty : 0;
+                s->commits++;
+            } else {
+                s->rejected_writes++;
+            }
+        }
+        s->pwm_commit = value;
+        return;
+    }
+    s->rejected_writes++;
+    qemu_log_mask(LOG_UNIMP, "mt6762 lab PWM write offset%#" HWADDR_PRIx "\n", offset);
+}
+
+static const MemoryRegionOps display_ops = {
+    .read = display_read,
+    .write = display_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void display_reset(void *opaque)
+{
+    MT6762DisplayLab *s = opaque;
+    memset(s->reads, 0, sizeof(s->reads));
+    s->pwm_writes = s->commits = s->rejected_writes = 0;
+    s->pwm_enable = 1;
+    s->pwm_con0 = 3u << 16;
+    s->pwm_con1 = (512u << 16) | 1023;
+    s->pwm_commit = 0;
+    s->applied_level = 512;
+}
+
+void mt6762_lab_display_configure(MT6762DisplayLab *s, unsigned fault)
+{
+    assert(fault < MT6762_DISPLAY_FAULT_COUNT);
+    s->fault = fault;
+}
+
+char *mt6762_lab_display_state(MT6762DisplayLab *s)
+{
+    if (!s) {
+        return g_strdup("{\"enabled\":false}");
+    }
+    return g_strdup_printf("{\"enabled\":true,\"synthetic\":true,"
+        "\"framebuffer_pa\":%" PRIu64 ",\"fault\":%u,\"applied_level\":%u,"
+        "\"enable\":%u,\"duty\":%u,\"pwm_writes\":%" PRIu64
+        ",\"commits\":%" PRIu64 ",\"rejected_writes\":%" PRIu64
+        ",\"reads\":{\"spm\":%" PRIu64 ",\"mmsys\":%" PRIu64
+        ",\"ovl\":%" PRIu64 ",\"rdma\":%" PRIu64 ",\"dsi\":%" PRIu64
+        ",\"pwm\":%" PRIu64 "}}",
+        s->framebuffer_pa, s->fault, s->applied_level, s->pwm_enable & 1,
+        (s->pwm_con1 >> 16) & 0x1fff, s->pwm_writes, s->commits, s->rejected_writes,
+        s->reads[SPM], s->reads[MMSYS], s->reads[OVL], s->reads[RDMA],
+        s->reads[DSI], s->reads[PWM]);
+}
+
+MT6762DisplayLab *mt6762_lab_display_create(Object *owner, MemoryRegion *memory,
+                                          uint64_t framebuffer_pa)
+{
+    static const hwaddr addresses[BLOCKS] = {
+        0x10006000, 0x14000000, 0x1400b000, 0x1400d000, 0x14014000, 0x1100e000
+    };
+    static const char *const names[BLOCKS] = {
+        "mt6762.lab-display-spm", "mt6762.lab-display-mmsys",
+        "mt6762.lab-display-ovl0", "mt6762.lab-display-rdma0",
+        "mt6762.lab-display-dsi0", "mt6762.lab-display-pwm0"
+    };
+    MT6762DisplayLab *s = g_new0(MT6762DisplayLab, 1);
+    s->framebuffer_pa = framebuffer_pa;
+    for (unsigned i = 0; i < BLOCKS; i++) {
+        s->blocks[i].display = s;
+        s->blocks[i].id = i;
+        memory_region_init_io(&s->blocks[i].region, owner, &display_ops,
+                              &s->blocks[i], names[i], 0x1000);
+        memory_region_add_subregion(memory, addresses[i], &s->blocks[i].region);
+    }
+    display_reset(s);
+    qemu_register_reset(display_reset, s);
+    return s;
+}
