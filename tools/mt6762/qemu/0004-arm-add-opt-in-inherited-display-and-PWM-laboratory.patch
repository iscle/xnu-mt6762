+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_ARM_MT6762_LAB_DISPLAY_H
+#define HW_ARM_MT6762_LAB_DISPLAY_H
+#include "system/memory.h"
+typedef struct MT6762DisplayLab MT6762DisplayLab;
+enum {
+    MT6762_DISPLAY_FAULT_NONE,
+    MT6762_DISPLAY_FAULT_PWM_DROP,
+    MT6762_DISPLAY_FAULT_POWER_OFF,
+    MT6762_DISPLAY_FAULT_SCANOUT,
+    MT6762_DISPLAY_FAULT_COUNT,
+};
+/* Board validates a 16KiB-aligned 0x144000-byte range in RAM below 4GiB.
+ * Shared TOPCKGEN/infracfg fixtures belong to mt6762_lab_i2c.c. */
+MT6762DisplayLab *mt6762_lab_display_create(Object *owner, MemoryRegion *memory,
+                                          uint64_t framebuffer_pa);
+void mt6762_lab_display_configure(MT6762DisplayLab *s, unsigned fault);
+char *mt6762_lab_display_state(MT6762DisplayLab *s);
+#endif
