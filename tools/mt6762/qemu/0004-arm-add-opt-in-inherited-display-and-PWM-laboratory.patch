+    MT6762MachineState *s = MT6762_MACHINE(obj);
+    unsigned i;
+    for (i = 0; i < ARRAY_SIZE(mt6762_display_fault_names); i++) {
+        if (!strcmp(value, mt6762_display_fault_names[i])) {
+            s->lab_display_fault = i;
+            if (s->display) {
+                mt6762_lab_display_configure(s->display, i);
