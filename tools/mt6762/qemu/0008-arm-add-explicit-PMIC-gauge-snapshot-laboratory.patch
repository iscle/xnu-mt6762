-    bool lab_power, lab_pmic_thermal;
+    bool lab_power, lab_pmic_thermal, lab_gauge;
     unsigned lab_power_fault;
     uint64_t lab_key_mask;
     MT6762PowerLab *power;
@@ -296,6 +296,10 @@ static void mt6762_init(MachineState *ms)
         s->sspm = mt6762_sspm_lab_create(OBJECT(s), sysmem);
