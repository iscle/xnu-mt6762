diff --git a/tests/mt6762/test_lab_gauge.py b/tests/mt6762/test_lab_gauge.py
new file mode 100644
index 0000000..796d314
--- /dev/null
+++ b/tests/mt6762/test_lab_gauge.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Paused-CPU opt-in gauge fixture tests; no phone access or gauge initialization."""
+import argparse
+import tempfile
+from pathlib import Path
+from test_lab_power import PowerLab
+
+def capture(lab):
+    assert lab.pmic(0xd0a) == 0
+    lab.pmic(0xd0a, 1)
+    assert lab.pmic(0xd0a) == 0x8001
+    assert lab.pmic(0xd8a) == 100
+    ticks = lab.pmic(0xd20) | lab.pmic(0xd22) << 16 | lab.pmic(0xd24) << 32
+    lab.pmic(0xd0a, 9)
+    assert lab.pmic(0xd0a) == 0x8009
+    lab.pmic(0xd0a, 8)
+    assert lab.pmic(0xd0a) == 8
+    lab.pmic(0xd0a, 0)
+    assert lab.pmic(0xd0a) == 0
+    return ticks
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--qemu',type=Path,required=True)
+    parser.add_argument('--dtb',type=Path,required=True)
+    args=parser.parse_args()
+    for fault in ['none','gauge-timeout','gauge-latch-stuck','gauge-stale',
+                  'gauge-clock','gauge-calibration','gauge-counter-stuck','absent']:
+        with tempfile.TemporaryDirectory(prefix='mt6762-gauge-qtest-') as directory:
+            lab=PowerLab(args.qemu.resolve(),args.dtb.resolve(),directory,gauge=fault!='absent')
+            try:
+                if fault=='absent':
+                    assert not lab.state()['gauge_enabled']
+                    assert lab.pmic(0xd0a)==0xffff
+                    continue
+                lab.fault(fault)
+                if fault=='none':
+                    assert lab.pmic(0xc0c)==0 and lab.pmic(0xd08)==0x29
+                    assert lab.pmic(0xc8e)==4096 and lab.pmic(0xd96)==4096
+                    a=capture(lab);lab.step(1000000000);b=capture(lab)
+                    assert b>a and lab.state()['gauge_snapshots']==2
+                    assert lab.state()['gauge_commands']==8
+                    n=lab.state()['rejected']
+                    for reg,value in [(0xd0a,0x705),(0xd08,0),(0xd94,1),(0xd96,1)]:lab.pmic(reg,value)
+                    assert lab.state()['rejected']==n+4 and lab.pmic(0xd0a)==0
+                    lab.fault('gauge-counter-stuck');lab.step(2000000000)
+                    assert capture(lab)==b and b>0
+                elif fault=='gauge-stale':
+                    assert lab.pmic(0xd0a)==0x8000 and lab.state()['gauge_commands']==0
+                elif fault=='gauge-clock':assert lab.pmic(0xc0c)==0x18
+                elif fault=='gauge-calibration':assert lab.pmic(0xd96)==4095
+                elif fault=='gauge-counter-stuck':
+                    assert capture(lab)==0;lab.step(2000000000);assert capture(lab)==0
+                elif fault=='gauge-timeout':
+                    lab.pmic(0xd0a,1);lab.step(20000000)
+                    assert lab.pmic(0xd0a)==1 and lab.state()['gauge_commands']==1
+                elif fault=='gauge-latch-stuck':
+                    lab.pmic(0xd0a,1);lab.pmic(0xd0a,9);lab.pmic(0xd0a,8)
+                    lab.step(20000000);assert lab.pmic(0xd0a)==0x8008
+                    n=lab.state()['rejected'];lab.pmic(0xd0a,0)
+                    assert lab.state()['rejected']==n+1 and lab.pmic(0xd0a)==0x8008
+            finally:lab.close()
+    print('PASS: synthetic gauge latch, NTER progression, faults, reset rejection and default absence')
+
+if __name__=='__main__':main()
