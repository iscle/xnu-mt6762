@@ -515,10 +520,27 @@ static void mt6762_set_lab_thermal(Object *obj, bool value, Error **errp)
     s->lab_pmic_thermal = value;
 }
 
+static bool mt6762_get_lab_gauge(Object *obj, Error **errp)
+{
+    return MT6762_MACHINE(obj)->lab_gauge;
+}
+
+static void mt6762_set_lab_gauge(Object *obj, bool value, Error **errp)
+{
+    MT6762MachineState *s = MT6762_MACHINE(obj);
+    if (s->initialized) {
+        error_setg(errp, "lab-gauge must be selected before initialization");
+        return;
+    }
+    s->lab_gauge = value;
+}
+
 static const char *const mt6762_power_fault_names[] = {
     "none", "stall", "init-loss", "bad-id", "adc-timeout", "adc-rail",
     "keypad-disabled", "thermal-timeout", "thermal-stale",
-    "thermal-uncalibrated", "thermal-bad-degc", "thermal-mux", "thermal-rail"
+    "thermal-uncalibrated", "thermal-bad-degc", "thermal-mux", "thermal-rail",
+    "gauge-timeout", "gauge-latch-stuck", "gauge-stale", "gauge-clock",
+    "gauge-calibration", "gauge-counter-stuck"
 };
 
 static char *mt6762_get_power_fault(Object *obj, Error **errp)
@@ -585,6 +607,8 @@ static void mt6762_class_init(ObjectClass *oc, const void *data)
     mc->default_cpus = 8;
     mc->no_floppy = 1;
     mc->no_cdrom = 1;
+    object_class_property_add_bool(oc, "lab-gauge", mt6762_get_lab_gauge,
+                                   mt6762_set_lab_gauge);
     object_class_property_add_bool(oc, "lab-pmic-thermal", mt6762_get_lab_thermal,
                                    mt6762_set_lab_thermal);
     object_class_property_add_bool(oc, "lab-power", mt6762_get_lab_power,
diff --git a/hw/arm/mt6762_lab_power.c b/hw/arm/mt6762_lab_power.c
index 534bd9d..77f1e90 100644
--- a/hw/arm/mt6762_lab_power.c
+++ b/hw/arm/mt6762_lab_power.c
@@ -19,6 +19,9 @@ struct MT6762PowerLab {
     MemoryRegion pwrap, keypad;
     QEMUTimer *transaction, *adc[5];
     bool thermal_enabled;
+    bool gauge_enabled;
+    uint16_t gauge_control;
+    uint64_t gauge_ticks, gauge_snapshots, gauge_commands;
     unsigned fault, keys, fsm;
     uint32_t command;
     uint16_t data, adc_data[5];
@@ -61,6 +64,24 @@ static uint16_t pmic_read(MT6762PowerLab *s, uint16_t address)
     case 0x108e:
         return s->adc_data[1];
     }
+    if (s->gauge_enabled) {
+        switch (address) {
+        case 0xc0c: return s->fault == MT6762_POWER_FAULT_GAUGE_CLOCK ? 0x18 : 0;
+        case 0xd08: return 0x29; /* Explicit synthetic initialized gauge. */
+        case 0xc8e: return 4096;
+        case 0xc90: case 0xd94: return 0;
+        case 0xd96:
+            return s->fault == MT6762_POWER_FAULT_GAUGE_CALIBRATION ? 4095 : 4096;
+        case 0xd0a:
+            return s->fault == MT6762_POWER_FAULT_GAUGE_STALE ?
+                   0x8000 : s->gauge_control;
+        case 0xd8a: return 100; /* Synthetic +31.4mA, never battery SOC. */
+        case 0xd12: case 0xd14: return 0;
+        case 0xd20: return s->gauge_ticks;
+        case 0xd22: return s->gauge_ticks >> 16;
+        case 0xd24: return (s->gauge_ticks >> 32) & 1;
+        }
+    }
     if (s->thermal_enabled) {
         switch (address) {
         case 0x11ae:
@@ -86,6 +107,38 @@ static uint16_t pmic_read(MT6762PowerLab *s, uint16_t address)
 static void pmic_write(MT6762PowerLab *s, uint16_t address, uint16_t data)
 {
     unsigned channel = 5;
+    if (s->gauge_enabled && address == 0xd0a &&
+        s->fault != MT6762_POWER_FAULT_GAUGE_STALE) {
+        unsigned phase = s->gauge_control & 9;
+        if (data == 1 && phase == 0 && !(s->gauge_control & 0x8000)) {
+            s->gauge_snapshots++;
+            if (s->fault != MT6762_POWER_FAULT_GAUGE_COUNTER_STUCK) {
+                s->gauge_ticks = (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) /
+                                  500000000) & ((UINT64_C(1) << 33) - 1);
+            }
+            s->gauge_control = s->fault == MT6762_POWER_FAULT_GAUGE_TIMEOUT ?
+                1 : 0x8001;
+            s->gauge_commands++;
+            return;
+        }
+        if (data == 9 && s->gauge_control == 0x8001) {
+            s->gauge_control = 0x8009;
+            s->gauge_commands++;
+            return;
+        }
+        if (data == 8 && s->gauge_control == 0x8009) {
+            s->gauge_control = s->fault == MT6762_POWER_FAULT_GAUGE_LATCH_STUCK ?
+                0x8008 : 8;
+            s->gauge_commands++;
+            return;
+        }
+        if (data == 0 && s->gauge_control == 8) {
+            s->gauge_control = 0;
+            s->gauge_commands++;
+            return;
+        }
+        /* Every other write, including any reset/calibration bit, is rejected. */
+    }
     if (address == 0x110e && (data == 2 || data == 8)) {
         channel = data == 2 ? 0 : 1;
     } else if (s->thermal_enabled) {
@@ -195,6 +248,8 @@ static void power_reset(void *opaque)
     }
     s->keys = s->fsm = s->command = s->data = 0;
     s->commands = s->reads = s->writes = s->rejected = s->clears = s->key_reads = 0;
+    s->gauge_control = 0;
+    s->gauge_ticks = s->gauge_snapshots = s->gauge_commands = 0;
 }
 MT6762PowerLab *mt6762_lab_power_create(Object *owner, MemoryRegion *memory)
 {
@@ -219,6 +274,10 @@ void mt6762_lab_power_set_thermal(MT6762PowerLab *s, bool enabled)
 {
     s->thermal_enabled = enabled;
 }
+void mt6762_lab_power_set_gauge(MT6762PowerLab *s, bool enabled)
+{
+    s->gauge_enabled = enabled;
+}
 void mt6762_lab_power_configure(MT6762PowerLab *s, unsigned fault)
 {
     s->fault = fault < MT6762_POWER_FAULT_COUNT ? fault : MT6762_POWER_FAULT_NONE;
@@ -241,11 +300,17 @@ char *mt6762_lab_power_state(MT6762PowerLab *s)
         "\"adc_completions\":[%" PRIu64 ",%" PRIu64 "],"
         "\"thermal_enabled\":%s,\"thermal_calibration_synthetic\":%s,"
         "\"thermal_requests\":[%" PRIu64 ",%" PRIu64 ",%" PRIu64 "],"
-        "\"thermal_completions\":[%" PRIu64 ",%" PRIu64 ",%" PRIu64 "]}",
+        "\"thermal_completions\":[%" PRIu64 ",%" PRIu64 ",%" PRIu64 "],"
+        "\"gauge_enabled\":%s,\"gauge_calibration_synthetic\":%s,"
+        "\"gauge_control\":%u,\"gauge_ticks\":%" PRIu64 ","
+        "\"gauge_snapshots\":%" PRIu64 ",\"gauge_commands\":%" PRIu64 "}",
         s->fault, s->keys, s->fsm, s->commands, s->reads, s->writes,
         s->rejected, s->clears, s->key_reads, s->adc_requests[0],
         s->adc_requests[1], s->adc_completions[0], s->adc_completions[1],
         s->thermal_enabled ? "true" : "false", s->thermal_enabled ? "true" : "false",
         s->adc_requests[2], s->adc_requests[3], s->adc_requests[4],
-        s->adc_completions[2], s->adc_completions[3], s->adc_completions[4]);
+        s->adc_completions[2], s->adc_completions[3], s->adc_completions[4],
+        s->gauge_enabled ? "true" : "false", s->gauge_enabled ? "true" : "false",
+        s->fault == MT6762_POWER_FAULT_GAUGE_STALE ? 0x8000 : s->gauge_control,
+        s->gauge_ticks, s->gauge_snapshots, s->gauge_commands);
 }
