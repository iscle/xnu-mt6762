diff --git a/hw/arm/mt6762.c b/hw/arm/mt6762.c
index e4c4048..b999c6a 100644
--- a/hw/arm/mt6762.c
+++ b/hw/arm/mt6762.c
@@ -657,7 +657,7 @@ static const char *const mt6762_power_fault_names[] = {
     "gauge-timeout", "gauge-latch-stuck", "gauge-stale", "gauge-clock",
