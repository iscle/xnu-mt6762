diff --git a/hw/arm/mt6762_lab_power.c b/hw/arm/mt6762_lab_power.c
index 84cbcce..41d215a 100644
--- a/hw/arm/mt6762_lab_power.c
+++ b/hw/arm/mt6762_lab_power.c
@@ -22,6 +22,7 @@ struct MT6762PowerLab {
     bool gauge_enabled, bif_enabled;
     unsigned adc_delay_us;
     uint64_t bif_tdet_writes;
+    uint64_t bif_trim_reads, bif_trim_write_attempts;
     uint16_t gauge_control;
     uint64_t gauge_sample, gauge_latched_sample;
     uint64_t gauge_ticks, gauge_snapshots, gauge_commands;
@@ -57,6 +58,17 @@ static void adc3_complete(void *opaque) { adc_complete(opaque, 3); }
 static void adc4_complete(void *opaque) { adc_complete(opaque, 4); }
 static void adc5_complete(void *opaque) { adc_complete(opaque, 5); }
 
+static int bif_trim_index(uint16_t address)
+{
+    if (address == 0x1008) {
+        return 0;
+    }
+    if (address >= 0x11a2 && address <= 0x11ac && !(address & 1)) {
+        return 1 + (address - 0x11a2) / 2;
+    }
+    return -1;
+}
+
 static uint16_t pmic_read(MT6762PowerLab *s, uint16_t address)
 {
     switch (address) {
@@ -72,8 +84,19 @@ static uint16_t pmic_read(MT6762PowerLab *s, uint16_t address)
         return s->adc_data[1];
     }
     if (s->bif_enabled) {
+        /* Raw identities only: not decoded or claimed calibrated/physical. */
+        static const uint16_t trim[7] = {
+            0x1357, 0x2468, 0x369c, 0x48ad, 0x5bce, 0x6df0, 0x7e12
+        };
+        int index = bif_trim_index(address);
+        if (index >= 0) {
+            s->bif_trim_reads++;
+            return trim[index] ^ (index == 3 &&
+                s->fault == MT6762_POWER_FAULT_BIF_TRIM ? 1 : 0);
+        }
         /* Explicit synthetic trim/configuration snapshot, not physical defaults. */
         switch (address) {
+        case 0x000a: return 0x0101; /* Synthetic SWCID, read-only. */
         case 0x1236:
             return s->fault == MT6762_POWER_FAULT_BIF_TDET_SET ||
                 (s->fault == MT6762_POWER_FAULT_BIF_TDET_CHANGED &&
@@ -129,6 +152,9 @@ static uint16_t pmic_read(MT6762PowerLab *s, uint16_t address)
 static void pmic_write(MT6762PowerLab *s, uint16_t address, uint16_t data)
 {
     unsigned channel = 6;
+    if (s->bif_enabled && bif_trim_index(address) >= 0) {
+        s->bif_trim_write_attempts++; /* Rejected by the common path below. */
+    }
     if (s->bif_enabled && address == 0x1236) {
         s->bif_tdet_writes++; /* All TDET writes remain rejected. */
     }
@@ -285,6 +311,7 @@ static void power_reset(void *opaque)
     s->commands = s->reads = s->writes = s->rejected = s->clears = s->key_reads = 0;
     s->gauge_control = 0;
     s->bif_tdet_writes = 0;
+    s->bif_trim_reads = s->bif_trim_write_attempts = 0;
     s->gauge_ticks = s->gauge_snapshots = s->gauge_commands = 0;
     s->gauge_latched_sample = s->gauge_sample;
 }
@@ -359,7 +386,9 @@ char *mt6762_lab_power_state(MT6762PowerLab *s)
         "\"gauge_snapshots\":%" PRIu64 ",\"gauge_commands\":%" PRIu64 ","
         "\"bif_enabled\":%s,\"bif_config_synthetic\":%s,\"adc_delay_us\":%u,"
         "\"bif_requests\":%" PRIu64 ",\"bif_completions\":%" PRIu64 ","
-        "\"bif_tdet_write_attempts\":%" PRIu64 "}",
+        "\"bif_tdet_write_attempts\":%" PRIu64 ","
+        "\"bif_trim_reads\":%" PRIu64 ","
+        "\"bif_trim_write_attempts\":%" PRIu64 "}",
         s->fault, s->keys, s->fsm, s->commands, s->reads, s->writes,
         s->rejected, s->clears, s->key_reads, s->adc_requests[0],
         s->adc_requests[1], s->adc_completions[0], s->adc_completions[1],
@@ -372,5 +401,6 @@ char *mt6762_lab_power_state(MT6762PowerLab *s)
         s->gauge_ticks, s->gauge_snapshots, s->gauge_commands,
         s->bif_enabled ? "true" : "false", s->bif_enabled ? "true" : "false",
         s->adc_delay_us,
-        s->adc_requests[5], s->adc_completions[5], s->bif_tdet_writes);
+        s->adc_requests[5], s->adc_completions[5], s->bif_tdet_writes,
+        s->bif_trim_reads, s->bif_trim_write_attempts);
 }
diff --git a/include/hw/arm/mt6762_lab_power.h b/include/hw/arm/mt6762_lab_power.h
index eb0b1f7..79ae869 100644
--- a/include/hw/arm/mt6762_lab_power.h
