diff --git a/tests/mt6762/test_lab_bif_trim.py b/tests/mt6762/test_lab_bif_trim.py
new file mode 100644
index 0000000..297c24e
--- /dev/null
+++ b/tests/mt6762/test_lab_bif_trim.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Local experiment: synthetic raw BIF words, no calibration interpretation.
+
+Tests actual PWRAP transactions with paused CPUs. No target or physical I/O.
+"""
+import argparse
+import tempfile
+from pathlib import Path
+from test_lab_power import PowerLab
+
+ADDRESSES = [0x1008, *range(0x11a2, 0x11ae, 2)]
+RAW = [0x1357, 0x2468, 0x369c, 0x48ad, 0x5bce, 0x6df0, 0x7e12]
+CHANGED = [*RAW[:3], RAW[3] ^ 1, *RAW[4:]]
+SELECTORS = [0x1236, 0x10de, 0x10e0, 0x1120, 0x1126, 0x1128,
+             0x112e, 0x1132, 0x1136, 0x113a, 0x113c]
+CONFIG = [4, 0x4000, *([0] * 9)]
+
+
+def read_trim(lab):
+    before = lab.state()['bif_trim_reads']
+    result = [lab.pmic(address) for address in ADDRESSES]
+    assert lab.state()['bif_trim_reads'] == before + 7
+    return result
+
+
+def verify_readonly(lab, expected):
+    before = lab.state()
+    for address, value in zip(ADDRESSES, expected):
+        lab.pmic(address, value ^ 0xffff)
+    after = lab.state()
+    assert after['rejected'] == before['rejected'] + 7
+    assert after['bif_trim_write_attempts'] == before['bif_trim_write_attempts'] + 7
+    assert read_trim(lab) == expected
+
+
+def exercise(lab, startup_fault):
+    if startup_fault:
+        lab.fault('bif-trim')
+    assert read_trim(lab) == (CHANGED if startup_fault else RAW)
+    assert lab.pmic(0x0008) == 0x5730 and lab.pmic(0x000a) == 0x0101
+    before = lab.state()['rejected']
+    lab.pmic(0x000a, 0xffff)
+    assert lab.pmic(0x000a) == 0x0101 and lab.state()['rejected'] == before + 1
+    assert [lab.pmic(a) for a in SELECTORS] == CONFIG
+    # A completed raw sample does not itself alter the trim identity.
+    lab.pmic(0x110e, 2048)
+    lab.step(80000)
+    assert lab.pmic(0x109e) == 0x8000 | 4089
+    assert lab.state()['bif_completions'] == 1
+    assert read_trim(lab) == (CHANGED if startup_fault else RAW)
+    lab.fault('bif-trim')  # Explicit post-sample injection in the normal case.
+    assert lab.state()['fault'] == 26
+    assert read_trim(lab) == CHANGED
+    assert lab.pmic(0x0008) == 0x5730 and lab.pmic(0x000a) == 0x0101
+    assert [lab.pmic(a) for a in SELECTORS] == CONFIG
+    assert lab.pmic(0x109e) == 0x8000 | 4089
+    assert lab.state()['bif_requests'] == lab.state()['bif_completions'] == 1
+    verify_readonly(lab, CHANGED)
+    lab.fault('none')
+    assert read_trim(lab) == RAW
+    verify_readonly(lab, RAW)
+    assert lab.state()['bif_tdet_write_attempts'] == 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--qemu', type=Path, required=True)
+    parser.add_argument('--dtb', type=Path, required=True)
+    args = parser.parse_args()
+    for startup_fault in (False, True):
+        with tempfile.TemporaryDirectory(prefix='mt6762-bif-trim-') as directory:
+            lab = PowerLab(args.qemu.resolve(), args.dtb.resolve(), directory, bif=True)
+            try:
+                exercise(lab, startup_fault)
+            finally:
+                lab.close()
+    # Other power fixtures must not accidentally expose BIF raw words.
+    for thermal in (False, True):
+        with tempfile.TemporaryDirectory(prefix='mt6762-no-bif-trim-') as directory:
+            lab = PowerLab(args.qemu.resolve(), args.dtb.resolve(), directory,
+                           thermal=thermal, gauge=thermal)
+            try:
+                for fault in ('none', 'bif-trim'):
+                    lab.fault(fault)
+                    before = lab.state()['rejected']
+                    assert [lab.pmic(a) for a in [0x000a, *ADDRESSES]] == [0xffff] * 8
+                    for address in [0x000a, *ADDRESSES]:
+                        lab.pmic(address, 0)
+                    state = lab.state()
+                    assert state['rejected'] == before + 16
+                    assert state['bif_trim_reads'] == state['bif_trim_write_attempts'] == 0
+            finally:
+                lab.close()
+    print('PASS: seven synthetic read-only words, startup/post-sample isolated shadow fault, default absence')
+
+
+if __name__ == '__main__':
+    main()
