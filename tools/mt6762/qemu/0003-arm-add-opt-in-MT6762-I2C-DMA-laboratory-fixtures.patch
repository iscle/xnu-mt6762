diff --git a/tests/mt6762/test_lab_i2c.py b/tests/mt6762/test_lab_i2c.py
new file mode 100755
index 0000000..eef44ed
--- /dev/null
+++ b/tests/mt6762/test_lab_i2c.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Local QTest checks for opt-in synthetic MT6762 I2C fixtures, not phone proof."""
+import argparse
+import json
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import time
+
+
+class VM:
+    def __init__(self, binary, dtb, enabled):
+        self.tmp = tempfile.TemporaryDirectory(prefix='mt6762-i2c-')
+        self.path = Path(self.tmp.name)
+        self.log = (self.path / 'qemu.log').open('w+')
+        self.proc = subprocess.Popen([str(binary), '-M', 'mt6762' + (',lab-i2c=on' if enabled else ''),
+            '-accel', 'qtest', '-smp', '1', '-m', '4096M', '-dtb', str(dtb),
+            '-display', 'none', '-monitor', 'none', '-serial', 'null',
+            '-qtest', f'unix:{self.path}/test,server=on,wait=off',
+            '-qtest-log', '/dev/null', '-qmp', f'unix:{self.path}/qmp,server=on,wait=off'],
+            stdout=self.log, stderr=subprocess.STDOUT)
+        for _ in range(200):
+            if self.proc.poll() is not None:
+                self.log.seek(0)
+                raise RuntimeError(self.log.read())
+            if (self.path / 'test').exists() and (self.path / 'qmp').exists():
+                break
+            time.sleep(.01)
+        self.qtest = socket.socket(socket.AF_UNIX); self.qtest.settimeout(5)
+        self.qtest.connect(str(self.path / 'test')); self.qt = self.qtest.makefile('rwb', buffering=0)
+        self.qmp = socket.socket(socket.AF_UNIX); self.qmp.settimeout(5)
+        self.qmp.connect(str(self.path / 'qmp')); self.qm = self.qmp.makefile('rwb', buffering=0)
+        json.loads(self.qm.readline()); self.command('qmp_capabilities')
+
+    def close(self):
+        try:
+            self.command('quit')
+        finally:
+            self.proc.wait(timeout=5)
+            self.qt.close(); self.qm.close(); self.qtest.close(); self.qmp.close()
+            self.log.close(); self.tmp.cleanup()
+
+    def command(self, cmd, **args):
+        self.qm.write(json.dumps({'execute': cmd, 'arguments': args}).encode() + b'\n')
+        while True:
+            r = json.loads(self.qm.readline())
+            if 'error' in r: raise RuntimeError(r)
+            if 'return' in r: return r['return']
+
+    def qtcmd(self, cmd):
+        self.qt.write(cmd.encode() + b'\n')
+        r = self.qt.readline().decode().strip()
+        assert r.startswith('OK'), (cmd, r)
+        return r[2:].strip()
+
+    def read(self, address, size=4):
+        return int(self.qtcmd(f'read{ {2:"w",4:"l"}[size]} {address:#x}'), 0)
+
+    def write(self, address, value, size=4):
+        self.qtcmd(f'write{ {2:"w",4:"l"}[size]} {address:#x} {value:#x}')
+
+    def put(self, address, data):
+        self.qtcmd(f'write {address:#x} {len(data)} 0x{data.hex()}')
+
+    def get(self, address, size):
+        return bytes.fromhex(self.qtcmd(f'read {address:#x} {size}')[2:])
+
+    def step(self):
+        self.qtcmd('clock_step 200000')
+
+    def fault(self, value):
+        self.command('qom-set', path='/machine', property='lab-i2c-fault', value=value)
+
+
+class Bus:
+    def __init__(self, vm, number):
+        self.vm = vm
+        self.base, self.dma = ((0x11007000, 0x11000080) if number == 0 else (0x11016000, 0x11000580))
+
+    def r(self, offset): return self.vm.read(self.base + offset, 2)
+    def w(self, offset, value): self.vm.write(self.base + offset, value, 2)
+    def d(self, offset): return self.vm.read(self.dma + offset)
+    def dw(self, offset, value): self.vm.write(self.dma + offset, value)
+    def reset(self): self.w(0x50, 1); self.dw(12, 1)
+
+    def begin(self, address, tx=b'', rx=0, dma=False, buffer=0x40010000, rx_length=None):
+        self.w(8, 0); self.w(12, 0x1ff); self.w(56, 1)
+        self.w(8, 0x12f)
+        self.w(16, 0x28 | (0x12 if tx and rx else 0) | (0x304 if dma else 0))
+        self.w(4, (address << 1) | (not tx))
+        self.w(20, len(tx) if tx else rx); self.w(68, rx if tx and rx else 0)
+        self.w(24, 2 if tx and rx else 1)
+        if dma:
+            if tx: self.vm.put(buffer, tx)
+            for off, val in [(0,0),(24,0 if tx else 1),(28,buffer & 0xffffffff if tx else 0),
+                    (84,buffer >> 32 if tx else 0),(32,buffer & 0xffffffff if rx else 0),
+                    (88,buffer >> 32 if rx else 0),(36,len(tx)),(40,rx if rx_length is None else rx_length)]:
+                self.dw(off,val)
+            self.dw(8,1)
+        else:
+            for byte in tx: self.w(0,byte)
+        self.w(64,1); self.w(36,1)
+
+    def run(self, address, tx=b'', rx=0, dma=False, buffer=0x40010000, **kw):
+        self.begin(address,tx,rx,dma,buffer,**kw); self.vm.step()
+        status=self.r(12)
+        data=(self.vm.get(buffer,rx) if dma else bytes(self.r(0) for _ in range(rx))) if status == 1 else b''
+        return status,data
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--qemu',type=Path,required=True);p.add_argument('--dtb',type=Path,required=True);a=p.parse_args()
+    results=[]
+    vm=VM(a.qemu.resolve(),a.dtb.resolve(),False)
+    try:
+        tree=vm.command('human-monitor-command',**{'command-line':'info mtree'})
+        assert 'mt6762.lab-' not in tree
+        assert json.loads(vm.command('qom-get',path='/machine',property='lab-i2c-state'))=={'enabled':False}
+        results.append('default machine has no synthetic peripheral mappings')
+    finally: vm.close()
+    vm=VM(a.qemu.resolve(),a.dtb.resolve(),True)
+    try:
+        b=Bus(vm,0);c=Bus(vm,5)
+        assert vm.read(0x10001090)&(1<<11) and vm.read(0x10001094)&(1<<18)
+        assert vm.read(0x100053a0)==0x1100 and vm.read(0x10005360)==0x11
+        b.begin(0x3b,b'\x0c',2);vm.step();assert b.r(36)==1 and b.r(12)==0
+        b.reset();vm.write(0x10001084,1<<11);vm.write(0x1000108c,1<<18)
+        assert b.run(0x3b,b'\x0c',2)==(1,b'\x00\x07')
+        # Controller IRQ reaches SPI84 (architectural INTID116); W1C deasserts.
+        assert vm.read(0x0c00020c)&(1<<20)
+        b.w(12,0x1ff);assert not vm.read(0x0c00020c)&(1<<20)
+        results.append('clock gates, verified pad fixtures, FIFO repeated START, IRQ/W1C')
+        assert c.run(0x6a,b'\x03',1)==(1,b'\xf0')
+        assert c.run(0x6a,b'\x00',1)==(1,b'\x10')
+        assert c.run(0x6a,b'\x01\x04')==(1,b'')
+        assert c.run(0x6a,b'\x01',1)==(1,b'\x04')
+        assert c.run(0x6a,b'\x00',1)==(1,b'\x00')
+        assert c.run(0x55,rx=1)[0]==2
+        results.append('synthetic PSC identity/status/control and unknown-address NACK')
+        assert b.run(0x50,rx=8)==(1,bytes(range(8)))
+        assert b.run(0x50,rx=9)[0]==256
+        assert b.run(0x50,bytes(range(9)))[0]==256
+        results.append('8-byte FIFO boundary and overflow rejection')
+        for n in (9,32,4096):
+            addr=0x40010000;vm.put(addr-4,b'\xa5'*(n+8))
+            assert b.run(0x50,rx=n,dma=True)==(1,bytes(i&255 for i in range(n)))
+            assert vm.get(addr-4,4)==b'\xa5'*4 and vm.get(addr+n,4)==b'\xa5'*4
+            assert b.d(8)==0 and b.r(36)==0
+        assert b.run(0x50,rx=4097,dma=True)[0]==256
+        assert b.run(0x50,b'\x20',32,True)==(1,bytes(range(32,64)))
+        assert b.run(0x50,rx=32,dma=True,buffer=0x100010000)==(1,bytes(range(32)))
+        for addr in (0x200000000,0x11007000,0x13ffffff0):
+            assert b.run(0x50,rx=32,dma=True,buffer=addr)[0]==64
+        assert b.run(0x50,rx=32,dma=True,rx_length=31)[0]==64
+        results.append('DMA lengths9/32/4096, shared TX/RX, 33-bit addresses, canaries, rejected ranges/lengths')
+        assert b.run(0x3b,rx=32,dma=True)==(1,bytes(32))
+        vm.command('qom-set',path='/machine',property='lab-touch-sequence',value=True)
+        first=b.run(0x3b,rx=32,dma=True)[1];assert first[:8]==bytes([0,1,0,100,0,200,63,0x90])
+        assert b.run(0x3b,rx=32,dma=True)[1][2]==0x80
+        for _ in range(14):b.run(0x3b,rx=32,dma=True)
+        assert b.run(0x3b,rx=32,dma=True)==(1,bytes(32))
+        results.append('opt-in synthetic AXS down/move/release packets')
+        for fault,status in [('nack',2),('dma',65)]:
+            vm.fault(fault);vm.put(0x40010000,b'\xcc'*32)
+            assert b.run(0x3b,rx=32,dma=True)[0]==status
+            assert vm.get(0x40010000,32)==b'\xcc'*32
+        vm.fault('stall');b.begin(0x3b,rx=32,dma=True);vm.step()
+        assert b.r(36)==1 and b.d(8)==1 and b.r(12)==0
+        vm.fault('none');vm.step();assert b.r(36)==1 and b.d(8)==1
+        b.w(0x50,1);assert b.d(8)==1
+        b.dw(12,1);assert b.d(8)==0
+        assert b.run(0x50,rx=1)==(1,b'\0')
+        results.append('fault injection, completion/error precedence, stalled DMA, separate reset recovery')
+        b.begin(0x3b,rx=32,dma=True)
+        vm.write(0x10001088,1<<18);vm.step()
+        assert b.r(36)==1 and b.d(8)==1 and b.r(12)==0
+        b.reset();vm.write(0x1000108c,1<<18)
+        vm.write(0x10001088,1<<18)
+        assert b.run(0x50,rx=1)==(1,b'\0')
+        b.begin(0x3b,rx=32,dma=True);vm.step();assert b.r(36)==1 and b.d(8)==1
+        b.reset();vm.write(0x1000108c,1<<18);vm.write(0x100000a0,1)
+        b.begin(0x50,rx=1);vm.step();assert b.r(36)==1 and b.r(12)==0
+        results.append('DMA clock dependency, mid-transfer gate loss, unsupported parent stall')
+        state=json.loads(vm.command('qom-get',path='/machine',property='lab-i2c-state'))
+        assert state['synthetic'] and state['i2c0']['dma_reads']>=20 and state['i2c5']['transactions']==6
+        assert state['i2c5']['psc_control']==4 and state['i2c5']['psc_status']==0
+        results.append('read-only QOM transaction counters for independent guest-driver integration evidence')
+    finally:vm.close()
+    print(json.dumps({'status':'passed','physical_hardware_tested':False,'checks':results},indent=2))
+
+if __name__=='__main__':main()
