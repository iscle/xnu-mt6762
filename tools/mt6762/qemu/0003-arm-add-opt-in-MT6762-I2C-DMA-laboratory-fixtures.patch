@@ -257,6 +271,63 @@ static void mt6762_init(MachineState *ms)
     arm_load_kernel(ARM_CPU(first_cpu), ms, &s->bootinfo);
 }
 
+static bool mt6762_get_lab_i2c(Object *obj, Error **errp)
+{
+    return MT6762_MACHINE(obj)->lab_i2c;
+}
+
+static void mt6762_set_lab_i2c(Object *obj, bool value, Error **errp)
+{
+    MT6762MachineState *s = MT6762_MACHINE(obj);
+    if (s->initialized) {
+        error_setg(errp, "lab-i2c must be selected before machine initialization");
+        return;
+    }
+    s->lab_i2c = value;
+}
+
+static bool mt6762_get_lab_touch(Object *obj, Error **errp)
+{
+    return MT6762_MACHINE(obj)->lab_touch;
+}
+
+static void mt6762_set_lab_touch(Object *obj, bool value, Error **errp)
+{
+    MT6762MachineState *s = MT6762_MACHINE(obj);
+    s->lab_touch = value;
+    if (s->lab) {
+        mt6762_lab_i2c_configure(s->lab, s->lab_fault, s->lab_touch);
+    }
+}
+
+static const char *const mt6762_fault_names[] = { "none", "nack", "dma", "stall" };
+
+static char *mt6762_get_lab_state(Object *obj, Error **errp)
+{
+    return mt6762_lab_i2c_state(MT6762_MACHINE(obj)->lab);
+}
+
+static char *mt6762_get_lab_fault(Object *obj, Error **errp)
+{
+    return g_strdup(mt6762_fault_names[MT6762_MACHINE(obj)->lab_fault]);
+}
+
+static void mt6762_set_lab_fault(Object *obj, const char *value, Error **errp)
+{
+    MT6762MachineState *s = MT6762_MACHINE(obj);
+    unsigned i;
+    for (i = 0; i < ARRAY_SIZE(mt6762_fault_names); i++) {
+        if (!strcmp(value, mt6762_fault_names[i])) {
+            s->lab_fault = i;
+            if (s->lab) {
+                mt6762_lab_i2c_configure(s->lab, s->lab_fault, s->lab_touch);
+            }
+            return;
+        }
+    }
+    error_setg(errp, "lab-i2c-fault must be none, nack, dma or stall");
+}
+
 static void mt6762_class_init(ObjectClass *oc, const void *data)
 {
     MachineClass *mc = MACHINE_CLASS(oc);
@@ -269,6 +340,15 @@ static void mt6762_class_init(ObjectClass *oc, const void *data)
     mc->default_cpus = 8;
     mc->no_floppy = 1;
     mc->no_cdrom = 1;
+    object_class_property_add_bool(oc, "lab-i2c", mt6762_get_lab_i2c,
+                                   mt6762_set_lab_i2c);
+    object_class_property_set_description(oc, "lab-i2c",
