diff --git a/hw/arm/mt6762_lab_i2c.c b/hw/arm/mt6762_lab_i2c.c
new file mode 100644
index 0000000..30f7cec
--- /dev/null
+++ b/hw/arm/mt6762_lab_i2c.c
@@ -0,0 +1,460 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * AI-assisted local experiment; not intended for upstream submission.
+ *
+ * MT6765 v2 register offsets, interrupt bits and gate locations come from
+ * the supplied BSP i2c-mtk.{c,h}, clk-mt6765.c and the dumped device tree.
+ * Test peripheral contents, transfer latency and fault injection are synthetic.
+ * This is not an electrical bus, IOMMU, coherency or physical-device model.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/arm/mt6762_lab_i2c.h"
+#include "system/address-spaces.h"
+#include "system/reset.h"
+
+enum { DATA = 0, ADDR = 4, MASK = 8, STATUS = 12, CONTROL = 16,
+       LENGTH = 20, TRANSACTIONS = 24, START = 36, FIFO_CLEAR = 56,
+       AUX_LENGTH = 68, SOFTRESET = 80, FIFO_STAT = 244 };
+enum { DMA_FLAG = 0, DMA_ENABLE = 8, DMA_RESET = 12, DMA_STOP = 16,
+       DMA_CON = 24, DMA_TX = 28, DMA_RX = 32, DMA_TX_LEN = 36,
+       DMA_RX_LEN = 40, DMA_TX_HIGH = 84, DMA_RX_HIGH = 88 };
+enum { COMPLETE = 1, ACKERR = 2, DMAERR = 64, BUSERR = 256 };
+#define REG(s, n) ((s)->reg[(n) / 4])
+#define DMA(s, n) ((s)->dma[(n) / 4])
+#define RAM_BASE UINT64_C(0x40000000)
+#define MAX_TRANSFER 4096
+
+typedef struct MT6762I2CBus {
+    MT6762I2CLab *lab;
+    MemoryRegion mmio, dma_mmio;
+    qemu_irq irq;
+    QEMUTimer *timer;
+    unsigned number, fault, tx_count, rx_count, rx_pos, frames;
+    uint64_t transactions, dma_reads, rx_bytes;
+    unsigned last_status;
+    bool overflow;
+    uint16_t reg[1024];
+    uint32_t dma[32];
+    uint8_t fifo[8], psc[7], scratch[256];
+} MT6762I2CBus;
+
+struct MT6762I2CLab {
+    MemoryRegion infra_mmio, top_mmio, gpio_mmio;
+    MT6762I2CBus bus[2];
+    uint64_t ram_size;
+    uint32_t gates[2], mux;
+    unsigned fault;
+    bool touch;
+};
+
+static void lab_irq(MT6762I2CBus *s)
+{
+    qemu_set_irq(s->irq, (REG(s, MASK) & REG(s, STATUS)) != 0);
+}
+
+static void lab_finish(MT6762I2CBus *s, unsigned status)
+{
+    s->last_status = status;
+    REG(s, START) = 0;
+    if (REG(s, CONTROL) & 4) {
+        DMA(s, DMA_ENABLE) = 0;
+        DMA(s, DMA_FLAG) = 1;
+    }
+    REG(s, STATUS) |= status;
+    lab_irq(s);
+}
+
+static bool lab_dma_range(MT6762I2CBus *s, uint64_t addr, size_t size)
+{
+    /* No MMIO DMA targets, integer wrapping or unsupported high address bits. */
+    return addr < (UINT64_C(1) << 33) && addr >= RAM_BASE &&
+           size <= MAX_TRANSFER && addr - RAM_BASE < s->lab->ram_size &&
+           size <= s->lab->ram_size - (addr - RAM_BASE);
+}
+
+static unsigned lab_endpoint(MT6762I2CBus *s, unsigned address,
+                             const uint8_t *tx, size_t nt,
+                             uint8_t *rx, size_t nr)
+{
+    size_t i;
+    memset(rx, 0, nr);
+    if (s->number == 0 && address == 0x3b) {
+        if (nt == 1 && tx[0] == 0x0c && nr == 2) {
+            rx[0] = 0; rx[1] = 7; /* Explicit test version, big endian. */
+            return 0;
+        }
+        if (nt || nr != 32) {
+            return ACKERR;
+        }
+        unsigned frame = s->frames++ % 64;
+        if (s->lab->touch) {
+            /* 8-ms polling: down, held/moved, then an explicit zero frame. */
+            if (frame < 16) {
+                unsigned x = 100 + frame, y = 200 + frame;
+                rx[1] = 1;
+                rx[2] = (frame ? 0x80 : 0) | (x >> 8);
+                rx[3] = x;
+                rx[4] = y >> 8; /* contact ID zero */
+                rx[5] = y;
+                rx[6] = 63;
+                rx[7] = 0x90;
+            }
+        }
+        return 0;
+    }
+    if (s->number == 5 && address == 0x6a) {
+        if (nt == 1 && nr && tx[0] < sizeof(s->psc) &&
+            nr <= sizeof(s->psc) - tx[0]) {
+            memcpy(rx, s->psc + tx[0], nr);
+            return 0;
+        }
+        if (nt == 2 && !nr && tx[0] < sizeof(s->psc) && tx[0] != 3) {
+            s->psc[tx[0]] = tx[1];
+            if (tx[0] == 1 && (tx[1] & 4)) {
+                /* Deterministic disable-only fixture transition, not battery physics. */
+                s->psc[0] &= ~0x30;
+            }
+            return 0;
+        }
+        return ACKERR;
+    }
+    /* Lab-only scratch peripheral for FIFO/DMA boundary tests, not a phone part. */
+    if (address == 0x50) {
+        unsigned index = nt ? tx[0] : 0;
+        for (i = 1; i < nt; i++) {
+            s->scratch[(index + i - 1) & 255] = tx[i];
+        }
+        for (i = 0; i < nr; i++) {
+            rx[i] = s->scratch[(index + i) & 255];
+        }
+        return 0;
+    }
+    return ACKERR;
+}
+
+static void lab_complete(void *opaque)
+{
+    MT6762I2CBus *s = opaque;
+    uint8_t tx[MAX_TRANSFER], rx[MAX_TRANSFER];
+    unsigned n = REG(s, TRANSACTIONS), length = REG(s, LENGTH);
+    unsigned control = REG(s, CONTROL), status;
+    bool dma = control & 4, read = REG(s, ADDR) & 1;
+    size_t nt = read ? 0 : length, nr = read ? length : 0;
+    uint64_t ta = DMA(s, DMA_TX) | (uint64_t)DMA(s, DMA_TX_HIGH) << 32;
+    uint64_t ra = DMA(s, DMA_RX) | (uint64_t)DMA(s, DMA_RX_HIGH) << 32;
+
+    /* Losing a prerequisite while active cannot complete a DMA transaction. */
+    if ((s->lab->gates[0] & BIT(11)) || (s->lab->mux & 0x87) ||
+        (dma && (s->lab->gates[1] & BIT(18)))) {
+        return;
+    }
+
+    if (n == 2 && !read && (control & 0x12) == 0x12) {
+        nr = REG(s, AUX_LENGTH);
+    } else if (n != 1) {
+        lab_finish(s, BUSERR);
+        return;
+    }
+    if (!length || nt > MAX_TRANSFER || nr > MAX_TRANSFER ||
+        (n == 2 && !nr) || s->overflow) {
+        lab_finish(s, BUSERR);
+        return;
+    }
+    if (s->fault == 1) {
+        lab_finish(s, ACKERR);
+        return;
+    }
+    if (s->fault == 2) {
+        /* Simultaneous completion/error deliberately tests error precedence. */
+        lab_finish(s, COMPLETE | DMAERR);
+        return;
+    }
+    if (dma) {
+        if (!(DMA(s, DMA_ENABLE) & 1) || DMA(s, DMA_TX_LEN) != nt ||
+            DMA(s, DMA_RX_LEN) != nr || DMA(s, DMA_CON) != (nt ? 0 : 1) ||
+            (nt && !lab_dma_range(s, ta, nt)) ||
+            (nr && !lab_dma_range(s, ra, nr))) {
+            lab_finish(s, DMAERR);
+            return;
+        }
+        if (nt && address_space_read(&address_space_memory, ta,
+                MEMTXATTRS_UNSPECIFIED, tx, nt) != MEMTX_OK) {
+            lab_finish(s, DMAERR);
+            return;
+        }
+    } else {
+        if (nt > 8 || nr > 8 || s->tx_count != nt) {
+            lab_finish(s, BUSERR);
+            return;
+        }
+        memcpy(tx, s->fifo, nt);
+    }
+    status = lab_endpoint(s, REG(s, ADDR) >> 1, tx, nt, rx, nr);
+    if (!status && nr) {
+        if (dma) {
+            if (address_space_write(&address_space_memory, ra,
+                    MEMTXATTRS_UNSPECIFIED, rx, nr) != MEMTX_OK) {
+                status = DMAERR;
+            }
+        } else {
+            memcpy(s->fifo, rx, nr);
+            s->rx_count = nr;
+            s->rx_pos = 0;
+        }
+    }
+    if (!status) {
+        s->rx_bytes += nr;
+        s->dma_reads += dma && nr;
+    }
+    lab_finish(s, status ? status : COMPLETE);
+}
+
+static uint64_t lab_i2c_read(void *opaque, hwaddr off, unsigned size)
+{
+    MT6762I2CBus *s = opaque;
+    if (off & 3) {
+        return 0;
+    }
+    if (off == DATA) {
+        return s->rx_pos < s->rx_count ? s->fifo[s->rx_pos++] : 0;
+    }
+    if (off == FIFO_STAT) {
+        return (s->rx_count - s->rx_pos) << 4;
+    }
+    return REG(s, off);
+}
+
+static void lab_i2c_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    MT6762I2CBus *s = opaque;
+    MT6762I2CLab *l = s->lab;
+    if (off & 3) {
+        return;
+    }
+    switch (off) {
+    case DATA:
+        if (s->tx_count < sizeof(s->fifo)) {
+            s->fifo[s->tx_count++] = val;
+        } else {
+            s->overflow = true;
+        }
+        break;
+    case STATUS:
+        REG(s, STATUS) &= ~val;
+        lab_irq(s);
+        break;
+    case MASK:
+        REG(s, MASK) = val & 0x1ff;
+        lab_irq(s);
+        break;
+    case FIFO_CLEAR:
+        s->tx_count = s->rx_count = s->rx_pos = 0;
+        s->overflow = false;
+        break;
+    case SOFTRESET:
+        if (val & 1) {
+            timer_del(s->timer);
+            memset(s->reg, 0, sizeof(s->reg));
+            s->tx_count = s->rx_count = s->rx_pos = 0;
+            s->overflow = false;
+            lab_irq(s);
+        }
+        break;
+    case START:
+        if (!(val & 1) || (REG(s, START) & 1)) {
+            break;
+        }
+        REG(s, START) = 1;
+        s->transactions++;
+        s->fault = l->fault;
+        /* Missing/unsupported clocks stall, rather than pretending success. */
+        if ((l->gates[0] & BIT(11)) || (l->mux & 0x87) ||
+            ((REG(s, CONTROL) & 4) && (l->gates[1] & BIT(18))) ||
+            s->fault == 3) {
+            break;
+        }
+        /* Fixed lab latency: explicitly not an SCL timing/electrical model. */
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 100000);
+        break;
+    default:
+        REG(s, off) = val;
+        break;
+    }
+}
+
+static const MemoryRegionOps lab_i2c_ops = {
+    .read = lab_i2c_read, .write = lab_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 2, .max_access_size = 2 },
+    .impl = { .min_access_size = 2, .max_access_size = 2 },
+};
+
+static uint64_t lab_dma_read(void *opaque, hwaddr off, unsigned size)
+{
+    MT6762I2CBus *s = opaque;
+    return DMA(s, off);
+}
+
+static void lab_dma_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    MT6762I2CBus *s = opaque;
+    if (off == DMA_RESET && (val & 1)) {
+        timer_del(s->timer);
+        memset(s->dma, 0, sizeof(s->dma));
+    } else if (off == DMA_STOP && (val & 1)) {
+        timer_del(s->timer);
+        lab_finish(s, DMAERR);
+    } else if (off == DMA_FLAG) {
+        DMA(s, off) = val ? DMA(s, off) & ~val : 0;
+    } else {
+        DMA(s, off) = val;
+    }
+}
+
+static const MemoryRegionOps lab_dma_ops = {
+    .read = lab_dma_read, .write = lab_dma_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t lab_infra_read(void *opaque, hwaddr off, unsigned size)
+{
+    MT6762I2CLab *s = opaque;
+    return off == 0x90 ? s->gates[0] : off == 0x94 ? s->gates[1] : 0;
+}
+
+static void lab_infra_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    MT6762I2CLab *s = opaque;
+    switch (off) {
+    case 0x80: s->gates[0] |= val; break;
+    case 0x84: s->gates[0] &= ~val; break;
+    case 0x88: s->gates[1] |= val; break;
+    case 0x8c: s->gates[1] &= ~val; break;
+    default: qemu_log_mask(LOG_UNIMP, "mt6762 lab infracfg write %#" HWADDR_PRIx "\n", off);
+    }
+}
+
+static uint64_t lab_top_read(void *opaque, hwaddr off, unsigned size)
+{
+    MT6762I2CLab *s = opaque;
+    return off == 0xa0 ? s->mux : 0;
+}
+
+static void lab_top_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    MT6762I2CLab *s = opaque;
+    switch (off) {
+    case 0xa0: s->mux = val; break;
+    case 0xa4: s->mux |= val; break;
+    case 0xa8: s->mux &= ~val; break;
+    case 4: break; /* Lab update commits immediately; PLLs are not modeled. */
+    default: qemu_log_mask(LOG_UNIMP, "mt6762 lab topckgen write %#" HWADDR_PRIx "\n", off);
+    }
+}
+
+static uint64_t lab_gpio_read(void *opaque, hwaddr off, unsigned size)
+{
+    return off == 0x3a0 ? 0x1100 : off == 0x360 ? 0x11 : 0;
+}
+
+static void lab_gpio_write(void *opaque, hwaddr off, uint64_t val, unsigned size)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "mt6762 lab GPIO fixture is read-only: %#" HWADDR_PRIx "\n", off);
+}
+
+#define LAB_OPS(name) static const MemoryRegionOps lab_##name##_ops = { \
+    .read = lab_##name##_read, .write = lab_##name##_write, \
+    .endianness = DEVICE_LITTLE_ENDIAN, \
+    .valid = { .min_access_size = 4, .max_access_size = 4 }, \
+}
+LAB_OPS(infra);
+LAB_OPS(top);
+LAB_OPS(gpio);
+
+static void lab_reset(void *opaque)
+{
+    MT6762I2CLab *s = opaque;
+    unsigned i, j;
+    s->gates[0] = BIT(11);
+    s->gates[1] = BIT(18);
+    s->mux = 0;
+    for (i = 0; i < 2; i++) {
+        MT6762I2CBus *b = &s->bus[i];
+        timer_del(b->timer);
+        memset(b->reg, 0, sizeof(b->reg));
+        memset(b->dma, 0, sizeof(b->dma));
+        memset(b->psc, 0, sizeof(b->psc));
+        b->psc[0] = 0x10; b->psc[3] = 0xf0;
+        b->tx_count = b->rx_count = b->rx_pos = b->frames = 0;
+        b->transactions = b->dma_reads = b->rx_bytes = 0;
+        b->last_status = 0;
+        b->overflow = false;
+        for (j = 0; j < sizeof(b->scratch); j++) {
+            b->scratch[j] = j;
+        }
+        lab_irq(b);
+    }
+}
+
+void mt6762_lab_i2c_configure(MT6762I2CLab *s, unsigned fault, bool touch)
+{
+    if (touch != s->touch) {
+        s->bus[0].frames = 0;
+    }
+    s->fault = fault;
+    s->touch = touch;
+}
+
+char *mt6762_lab_i2c_state(MT6762I2CLab *s)
+{
+    if (!s) {
+        return g_strdup("{\"enabled\":false}");
+    }
+    return g_strdup_printf("{\"enabled\":true,\"synthetic\":true,"
+        "\"i2c0\":{\"transactions\":%" PRIu64 ",\"dma_reads\":%" PRIu64
+        ",\"rx_bytes\":%" PRIu64 ",\"last_status\":%u},"
+        "\"i2c5\":{\"transactions\":%" PRIu64 ",\"dma_reads\":%" PRIu64
+        ",\"rx_bytes\":%" PRIu64 ",\"last_status\":%u,\"psc_control\":%u,\"psc_status\":%u}}",
+        s->bus[0].transactions, s->bus[0].dma_reads, s->bus[0].rx_bytes, s->bus[0].last_status,
+        s->bus[1].transactions, s->bus[1].dma_reads, s->bus[1].rx_bytes, s->bus[1].last_status,
+        s->bus[1].psc[1], s->bus[1].psc[0]);
+}
+
+MT6762I2CLab *mt6762_lab_i2c_create(Object *owner, MemoryRegion *memory,
+                                  uint64_t ram_size, qemu_irq irq0, qemu_irq irq5)
+{
+    MT6762I2CLab *s = g_new0(MT6762I2CLab, 1);
+    static const hwaddr base[] = { 0x11007000, 0x11016000 };
+    static const hwaddr dma[] = { 0x11000080, 0x11000580 };
+    unsigned i;
+    s->ram_size = ram_size;
+    for (i = 0; i < 2; i++) {
+        MT6762I2CBus *b = &s->bus[i];
+        b->lab = s;
+        b->number = i ? 5 : 0;
+        b->irq = i ? irq5 : irq0;
+        b->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, lab_complete, b);
+        memory_region_init_io(&b->mmio, owner, &lab_i2c_ops, b,
+                              i ? "mt6762.lab-i2c5" : "mt6762.lab-i2c0", 0x1000);
+        memory_region_add_subregion(memory, base[i], &b->mmio);
+        memory_region_init_io(&b->dma_mmio, owner, &lab_dma_ops, b,
+                              i ? "mt6762.lab-apdma5" : "mt6762.lab-apdma0", 0x80);
+        memory_region_add_subregion(memory, dma[i], &b->dma_mmio);
+    }
+    memory_region_init_io(&s->infra_mmio, owner, &lab_infra_ops, s,
+                          "mt6762.lab-infracfg", 0x1000);
+    memory_region_add_subregion(memory, 0x10001000, &s->infra_mmio);
+    memory_region_init_io(&s->top_mmio, owner, &lab_top_ops, s,
+                          "mt6762.lab-topckgen", 0x1000);
+    memory_region_add_subregion(memory, 0x10000000, &s->top_mmio);
+    memory_region_init_io(&s->gpio_mmio, owner, &lab_gpio_ops, s,
+                          "mt6762.lab-gpio-fixture", 0x1000);
+    memory_region_add_subregion(memory, 0x10005000, &s->gpio_mmio);
+    lab_reset(s);
+    qemu_register_reset(lab_reset, s);
+    return s;
+}
