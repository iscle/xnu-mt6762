+    object_class_property_add_bool(oc, "lab-touch-sequence", mt6762_get_lab_touch,
+                                   mt6762_set_lab_touch);
+    object_class_property_add_str(oc, "lab-i2c-fault", mt6762_get_lab_fault,
+                                  mt6762_set_lab_fault);
+    object_class_property_add_str(oc, "lab-i2c-state", mt6762_get_lab_state, NULL);
 }
 
