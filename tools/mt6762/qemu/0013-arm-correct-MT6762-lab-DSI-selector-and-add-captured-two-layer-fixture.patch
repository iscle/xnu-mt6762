From 944a34afa8a40f2a4a05b4134e9bfa6c9835b633 Mon Sep 17 00:00:00 2001
From: Iscle <albertiscle9@gmail.com>
Date: Sun, 25 Oct 2026 22:54:27 +0100
Subject: [PATCH] arm: correct MT6762 lab DSI selector and add captured
 two-layer fixture

AI-assisted local experiment only; not intended for upstream submission. Keep the default inherited single-layer fixture, correcting RGB888 PS selector from2 to3 per selected LK DSI_PS_Control. Add an explicit immutable two-layer mode based on captured register values, with RAM-bound admission and read-only pipeline guards. QTest covers both modes, rejected writes, fault injection, immutability and invalid configuration.
---
 hw/arm/mt6762.c                     | 27 +++++++++++
 hw/arm/mt6762_lab_display.c         | 35 +++++++++++----
 include/hw/arm/mt6762_lab_display.h |  1 +
 tests/mt6762/test_lab_display.py    | 69 +++++++++++++++++++++++++++--
 4 files changed, 120 insertions(+), 12 deletions(-)

diff --git a/hw/arm/mt6762.c b/hw/arm/mt6762.c
index b999c6a..1fc8b86 100644
--- a/hw/arm/mt6762.c
+++ b/hw/arm/mt6762.c
@@ -63,6 +63,7 @@ struct MT6762MachineState {
     unsigned lab_sspm_fault;
     MT6762SSPMLab *sspm;
     bool lab_power, lab_pmic_thermal, lab_gauge, lab_bif;
+    bool lab_display_two_layer;
     uint64_t lab_adc_delay_us, lab_gauge_sample;
     bool lab_gauge_sample_set;
     unsigned lab_power_fault;
@@ -277,6 +278,13 @@ static void mt6762_init(MachineState *ms)
     memory_region_add_subregion(sysmem, 0x10017000, &s->systimer_mmio);
     qemu_register_reset(mt6762_reset, s);
 
+    if (s->lab_display_two_layer && (!s->lab_display ||
+        s->lab_display_fb != 0x7ef90000 ||
+        ms->ram_size < 0x7f218000ULL - MT6762_RAM_BASE)) {
+        error_report("lab-display-two-layer requires lab-display, "
+                     "lab-display-fb=0x7ef90000 and RAM through 0x7f218000");
+        exit(EXIT_FAILURE);
+    }
     if (s->lab_display && (!s->lab_i2c ||
         s->lab_display_fb < MT6762_RAM_BASE ||
         (s->lab_display_fb & 0x3fff) || s->lab_display_fb > UINT32_MAX ||
@@ -297,6 +305,7 @@ static void mt6762_init(MachineState *ms)
         mt6762_lab_i2c_display(s->lab, true);
         s->display = mt6762_lab_display_create(OBJECT(s), sysmem,
                                                s->lab_display_fb);
+        mt6762_lab_display_set_two_layer(s->display, s->lab_display_two_layer);
         mt6762_lab_display_configure(s->display, s->lab_display_fault);
     }
     if (s->lab_sspm) {
@@ -500,6 +509,21 @@ static void mt6762_get_display_fb(Object *obj, Visitor *v, const char *name,
     visit_type_uint64(v, name, &value, errp);
 }
 
+static bool mt6762_get_display_two_layer(Object *obj, Error **errp)
+{
+    return MT6762_MACHINE(obj)->lab_display_two_layer;
+}
+
+static void mt6762_set_display_two_layer(Object *obj, bool value, Error **errp)
+{
+    MT6762MachineState *s = MT6762_MACHINE(obj);
+    if (s->initialized) {
+        error_setg(errp, "lab-display-two-layer must be selected before initialization");
+        return;
+    }
+    s->lab_display_two_layer = value;
+}
+
 static void mt6762_set_display_fb(Object *obj, Visitor *v, const char *name,
                                  void *opaque, Error **errp)
 {
@@ -801,6 +825,9 @@ static void mt6762_class_init(ObjectClass *oc, const void *data)
     object_class_property_add_str(oc, "lab-sspm-state", mt6762_get_sspm_state, NULL);
     object_class_property_add_bool(oc, "lab-display", mt6762_get_lab_display,
                                    mt6762_set_lab_display);
+    object_class_property_add_bool(oc, "lab-display-two-layer",
+                                  mt6762_get_display_two_layer,
+                                  mt6762_set_display_two_layer);
     object_class_property_add(oc, "lab-display-fb", "uint64",
                               mt6762_get_display_fb, mt6762_set_display_fb,
                               NULL, NULL);
diff --git a/hw/arm/mt6762_lab_display.c b/hw/arm/mt6762_lab_display.c
index 89c24f5..8b7ef6f 100644
--- a/hw/arm/mt6762_lab_display.c
+++ b/hw/arm/mt6762_lab_display.c
@@ -5,6 +5,8 @@
  * Explicit synthetic inherited-display fixture for native-consumer tests.
  * The supplied MT6765 BSP defines these register offsets; fixed pipeline
  * contents and PWM latching are test assumptions, not physical observations.
+ * The opt-in two-layer register values reproduce a captured LK handoff, but
+ * their emulation still does not establish physical display behavior.
  * No DSI packets, panel, DMA fetch, SMI/IOMMU, pixel scanout or real clocks are
  * emulated. The framebuffer remains ordinary guest RAM observed by host tools.
  */
@@ -23,6 +25,7 @@ struct MT6762DisplayLab {
     DisplayBlock blocks[BLOCKS];
     uint64_t framebuffer_pa, reads[BLOCKS], pwm_writes, commits, rejected_writes;
     unsigned fault, applied_level;
+    bool two_layer;
     uint32_t pwm_enable, pwm_con0, pwm_con1, pwm_commit;
 };
 
@@ -47,27 +50,37 @@ static uint64_t display_read(void *opaque, hwaddr offset, unsigned size)
         break;
     case OVL:
         switch (offset) {
-        case 0x00c: case 0x02c: case 0x0c0: return 1;
+        case 0x00c: return 1;
+        case 0x02c: return s->two_layer ? 3 : 1;
+        case 0x0c0: return s->two_layer ? 0x520001 : 1;
         case 0x020: case 0x038: return 384 | (854u << 16);
-        case 0x030: return 0x20ff; /* BGRA8888, memory source, alpha disabled */
+        case 0x030: return s->two_layer ? 0x21ff : 0x20ff;
         case 0x044: return 1536;
         case 0xf40:
             return s->framebuffer_pa +
                 (s->fault == MT6762_DISPLAY_FAULT_SCANOUT ? 0x4000 : 0);
-        case 0x03c: case 0x04c: case 0x324: return 0;
+        case 0x024: case 0x03c: case 0x04c: case 0x324: case 0x3a0: return 0;
+        case 0x050: return s->two_layer ? 0x21ff : 0;
+        case 0x058: return s->two_layer ? 384 | (854u << 16) : 0;
+        case 0x064: return s->two_layer ? 1536 : 0;
+        case 0x0e0: return s->two_layer ? 0x480001 : 0;
+        case 0xf60: return s->two_layer ? 0x7f0d4000 +
+            (s->fault == MT6762_DISPLAY_FAULT_SCANOUT ? 0x4000 : 0) : 0;
+        case 0x05c: case 0x06c: return 0;
         }
         break;
     case RDMA:
         if (offset == 0x010) {
-            return 1; /* Engine on, direct-link mode */
+            return s->two_layer ? 0x101 : 1; /* Direct-link mode */
         }
         break;
     case DSI:
         switch (offset) {
         case 0x000: return 1;
         case 0x014: return 2; /* SYNC_EVENT_VDO */
-        case 0x018: return 7u << 2; /* Three-lane bit mask */
-        case 0x01c: return (2u << 16) | 1152; /* RGB888,384*3 bytes */
+        case 0x018: return s->two_layer ? 0x1001c : 7u << 2;
+        /* LK DSI_PS_Control maps RGB888 enum2 to hardware5-2=3. */
+        case 0x01c: return s->two_layer ? 0x2c030480 : (3u << 16) | 1152;
         case 0x020: return 2;
         case 0x024: return 20;
         case 0x028: return 170;
@@ -164,19 +177,25 @@ void mt6762_lab_display_configure(MT6762DisplayLab *s, unsigned fault)
     s->fault = fault;
 }
 
+void mt6762_lab_display_set_two_layer(MT6762DisplayLab *s, bool enabled)
+{
+    s->two_layer = enabled;
+}
+
 char *mt6762_lab_display_state(MT6762DisplayLab *s)
 {
     if (!s) {
         return g_strdup("{\"enabled\":false}");
     }
     return g_strdup_printf("{\"enabled\":true,\"synthetic\":true,"
-        "\"framebuffer_pa\":%" PRIu64 ",\"fault\":%u,\"applied_level\":%u,"
+        "\"two_layer\":%s,\"framebuffer_pa\":%" PRIu64 ",\"fault\":%u,\"applied_level\":%u,"
         "\"enable\":%u,\"duty\":%u,\"pwm_writes\":%" PRIu64
         ",\"commits\":%" PRIu64 ",\"rejected_writes\":%" PRIu64
         ",\"reads\":{\"spm\":%" PRIu64 ",\"mmsys\":%" PRIu64
         ",\"ovl\":%" PRIu64 ",\"rdma\":%" PRIu64 ",\"dsi\":%" PRIu64
         ",\"pwm\":%" PRIu64 "}}",
-        s->framebuffer_pa, s->fault, s->applied_level, s->pwm_enable & 1,
+        s->two_layer ? "true" : "false", s->framebuffer_pa,
+        s->fault, s->applied_level, s->pwm_enable & 1,
         (s->pwm_con1 >> 16) & 0x1fff, s->pwm_writes, s->commits, s->rejected_writes,
         s->reads[SPM], s->reads[MMSYS], s->reads[OVL], s->reads[RDMA],
         s->reads[DSI], s->reads[PWM]);
diff --git a/include/hw/arm/mt6762_lab_display.h b/include/hw/arm/mt6762_lab_display.h
index 6e3af19..f8351a3 100644
--- a/include/hw/arm/mt6762_lab_display.h
+++ b/include/hw/arm/mt6762_lab_display.h
@@ -15,5 +15,6 @@ enum {
 MT6762DisplayLab *mt6762_lab_display_create(Object *owner, MemoryRegion *memory,
                                           uint64_t framebuffer_pa);
 void mt6762_lab_display_configure(MT6762DisplayLab *s, unsigned fault);
+void mt6762_lab_display_set_two_layer(MT6762DisplayLab *s, bool enabled);
 char *mt6762_lab_display_state(MT6762DisplayLab *s);
 #endif
diff --git a/tests/mt6762/test_lab_display.py b/tests/mt6762/test_lab_display.py
index 4bce4d9..663d0f9 100644
--- a/tests/mt6762/test_lab_display.py
+++ b/tests/mt6762/test_lab_display.py
@@ -15,17 +15,18 @@
 
 
 class Lab:
-    def __init__(self, qemu, dtb, directory, enabled=True, accel='tcg'):
+    def __init__(self, qemu, dtb, directory, enabled=True, accel='tcg', two_layer=False):
         directory = Path(directory)
         self.log = (directory / "qemu.log").open("w+")
         self.qmp_path = directory / "qmp.sock"
         self.test_path = directory / "qtest.sock"
         machine = "mt6762,lab-i2c=on"
         if enabled:
-            machine += ",lab-display=on,lab-display-fb=0x41000000"
+            machine += ",lab-display=on,lab-display-fb=" + (
+                "0x7ef90000,lab-display-two-layer=on" if two_layer else "0x41000000")
         self.process = subprocess.Popen([
             str(qemu), "-M", machine, "-accel", accel, "-cpu", "cortex-a53",
-            "-m", "512M", "-smp", "1", "-dtb", str(dtb),
+            "-m", "1024M" if two_layer else "512M", "-smp", "1", "-dtb", str(dtb),
             *([] if accel == 'qtest' else ['-S']),
             "-display", "none", "-serial", "null", "-monitor", "none",
             "-qmp", f"unix:{self.qmp_path},server=on,wait=off",
@@ -111,7 +112,18 @@ def exercise(lab):
     assert lab.read(0x10006180) == lab.read(0x10006184) == 8
     assert lab.read(0x10000080) == 0x03000000
     assert not lab.read(0x100010ac) & 4
-    assert lab.read(0x1401401c) == (2 << 16) | 1152
+    assert lab.read(0x1401401c) == (3 << 16) | 1152
+    assert not lab.state()["two_layer"]
+    assert lab.read(0x1400b02c) == 1 and lab.read(0x1400b030) == 0x20ff
+    assert lab.read(0x1400bf60) == lab.read(0x1400b050) == 0
+    before = lab.state()['reads']['ovl']
+    assert lab.read(0x1400b024) == lab.read(0x1400b3a0) == 0
+    assert lab.state()['reads']['ovl'] == before + 2
+    before = lab.state()['rejected_writes']
+    lab.write(0x1400b024, 0xffffffff)
+    lab.write(0x1400b3a0, 0xffffffff)
+    assert lab.read(0x1400b024) == lab.read(0x1400b3a0) == 0
+    assert lab.state()['rejected_writes'] == before + 2
     pwm = 0x1100e000
     assert lab.read(pwm + 0x18) == 3 << 16
     assert lab.read(pwm + 0x1c) == (512 << 16) | 1023
@@ -163,6 +175,43 @@ def main():
             result = exercise(lab)
         finally:
             lab.close()
+        lab = Lab(args.qemu.resolve(), args.dtb.resolve(), temporary, two_layer=True)
+        try:
+            assert lab.state()["two_layer"]
+            registers = {
+                0x1400b00c: 1, 0x1400b02c: 3, 0x1400b020: 384 | (854 << 16),
+                0x1400b030: 0x21ff, 0x1400b050: 0x21ff,
+                0x1400b038: 384 | (854 << 16), 0x1400b058: 384 | (854 << 16),
+                0x1400b044: 1536, 0x1400b064: 1536,
+                0x1400bf40: 0x7ef90000, 0x1400bf60: 0x7f0d4000,
+                0x1400b03c: 0, 0x1400b05c: 0, 0x1400b04c: 0, 0x1400b06c: 0,
+                0x1400b324: 0, 0x1400b024: 0, 0x1400b3a0: 0,
+                0x1400b0c0: 0x520001, 0x1400b0e0: 0x480001,
+                0x1400d010: 0x101, 0x14014000: 1, 0x14014014: 2,
+                0x14014018: 0x1001c, 0x1401401c: 0x2c030480,
+                0x14014020: 2, 0x14014024: 20, 0x14014028: 170, 0x1401402c: 854,
+            }
+            before = lab.state()['reads']['ovl']
+            assert {a: lab.read(a) for a in registers} == registers
+            assert lab.state()['reads']['ovl'] == before + sum(
+                0x1400b000 <= a < 0x1400c000 for a in registers)
+            before = lab.state()["rejected_writes"]
+            for address, value in registers.items():
+                lab.write(address, value ^ 0xffffffff)
+            assert {a: lab.read(a) for a in registers} == registers
+            assert lab.state()["rejected_writes"] == before + len(registers)
+            try:
+                lab.command('qom-set', path='/machine', property='lab-display-two-layer', value=False)
+                raise AssertionError('fixture mode must be immutable')
+            except RuntimeError as error:
+                assert 'before initialization' in str(error)
+            lab.fault('scanout-mismatch')
+            assert lab.read(0x1400bf40) == 0x7ef94000
+            assert lab.read(0x1400bf60) == 0x7f0d8000
+            lab.fault('none')
+            assert {a: lab.read(a) for a in registers} == registers
+        finally:
+            lab.close()
         lab = Lab(args.qemu.resolve(), args.dtb.resolve(), temporary, enabled=False)
         try:
             assert lab.state() == {"enabled": False}
@@ -185,6 +234,18 @@ def main():
             "-S", "-display", "none", "-serial", "null", "-monitor", "none",
         ], capture_output=True, timeout=10)
         assert failed.returncode != 0 and b"lab-display requires" in failed.stderr, failed.stderr
+    for options, memory in [
+        ('lab-display-two-layer=on', '1024M'),
+        ('lab-i2c=on,lab-display=on,lab-display-two-layer=on,lab-display-fb=0x41000000', '1024M'),
+        ('lab-i2c=on,lab-display=on,lab-display-two-layer=on,lab-display-fb=0x7ef90000', '512M'),
+        ('lab-i2c=on,lab-display=on,lab-display-two-layer=on,lab-display-fb=0x7ef90000', '1010M'),
+    ]:
+        failed = subprocess.run([
+            str(args.qemu.resolve()), '-M', 'mt6762,' + options, '-m', memory,
+            '-accel', 'tcg', '-smp', '1', '-dtb', str(args.dtb.resolve()),
+            '-S', '-display', 'none', '-serial', 'null', '-monitor', 'none',
+        ], capture_output=True, timeout=10)
+        assert failed.returncode != 0 and b'lab-display-two-layer requires' in failed.stderr
     print(json.dumps({"synthetic_only": True, "passed": True, "final_fixture_state": result}, indent=2))
 
 
-- 
